async function init() {
  updateMarketTag();
  tickLocalClock();
  await Promise.all([
    loadStatus(),
    loadNavHistory(),
    loadPositions(),
    loadCandidates(),
    loadLiveOverview(),
    loadTradesHistory(true),
    loadIndexStrip(),
    loadLiveEvents()
  ]);
  modeInitialized = true;
  refreshHeaderStats();  // Task#82: 首屏即用快照口径渲染头部统计
}
init();
})();
