function initPieChart(holdings, totalCapital) {
  const dom = document.getElementById('pieChart');
  if (!dom) return;
  pieChartInstance = echarts.init(dom, 'dark');

  let data = [];
  let usedCapital = 0;
  if (holdings && holdings.length > 0) {
    const slotCap = totalCapital / 5;
    holdings.forEach(p => {
      data.push({ name: p.name + '(' + p.code.split('.')[1] + ')', value: slotCap });
      usedCapital += slotCap;
    });
  }
  const freeCap = totalCapital - usedCapital;
  if (freeCap > 0) {
    data.push({ name: '现金', value: freeCap, itemStyle: { color: '#2a3a52' } });
  }

  const option = {
    backgroundColor: 'transparent',
    tooltip: { trigger: 'item', backgroundColor: '#141d2b', borderColor: '#1a2436', textStyle: { color: '#e8edf5', fontSize: 12 }, formatter: '{b}: {d}%' },
