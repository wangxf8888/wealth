<script>
(function() {
'use strict';

// ===== Mode Switch =====
let currentMode = 'live'; // 'live' | 'backtest'

document.querySelectorAll('.mode-tab').forEach(tab => {
  tab.addEventListener('click', function() {
    if (this.dataset.mode === currentMode) return;
    document.querySelectorAll('.mode-tab').forEach(t => t.classList.remove('active'));
    this.classList.add('active');
    currentMode = this.dataset.mode;
    if (currentMode === 'live') {
      kpiClosedRendered = false;  // 回到实盘Tab: 重新渲染头部统计
      loadLiveOverview();
      loadLiveEquity();
      loadTradesHistory(true);
      refreshHeaderStats();
    } else {
      loadBacktestOverview();
      loadBacktestEquity();
      loadTradesHistory(true);
    }
  });
});

// ===== Utilities =====
async function fetchJSON(url) {
  const r = await fetch(url);
  if (!r.ok) throw new Error(r.statusText);
  return r.json();
}

function isMarketOpen() {
  const now = new Date();
  const day = now.getDay();
  if (day === 0 || day === 6) return false;
  const t = now.getHours() * 60 + now.getMinutes();
  // 9:25竞价结束到15:00收盘 (9*60+25=565, 15*60=900)
  return t >= 565 && t <= 900;
}

// 判断是否在交易时段（9:25-15:00），用于刷新控制
function isTradeSession() {
  const now = new Date();
  const day = now.getDay();
  if (day === 0 || day === 6) return false;
  const t = now.getHours() * 60 + now.getMinutes();
  return t >= 565 && t <= 900;
}

function getMarketStatusText() {
  const now = new Date();
  const day = now.getDay();
  const t = now.getHours() * 60 + now.getMinutes();
  if (day === 0 || day === 6) return '休市';
  if (t >= 540 && t < 565) return '竞价中';           // 09:00-09:24
  if (t >= 565 && t < 570) return '竞价结束·确认中';  // 09:25-09:29
  if (t >= 570 && t <= 690) return '交易中';           // 09:30-11:30
  if (t > 690 && t < 780) return '午休';               // 11:30-13:00
  if (t >= 780 && t <= 900) return '交易中';           // 13:00-15:00
  if (t > 900) return '已收盘';                        // 15:00+
  return '盘前';                                        // 00:00-09:00
}

function updateMarketTag() {
  const tag = document.getElementById('marketTag');
  const posTag = document.getElementById('posMarketTag');
  const open = isMarketOpen();
  const text = getMarketStatusText();
  tag.textContent = (open ? '● ' : '○ ') + text;
  tag.className = 'market-tag ' + (open ? 'open' : 'closed');
  if (posTag) {
    posTag.textContent = (open ? '● ' : '○ ') + text;
    posTag.className = 'market-tag ' + (open ? 'open' : 'closed');
  }
}

