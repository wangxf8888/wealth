      labelLine: { lineStyle: { color: '#2a3a52' } },
      emphasis: { itemStyle: { shadowBlur: 10, shadowColor: 'rgba(0,0,0,0.3)' } },
      data: data
    }]
  };
  pieChartInstance.setOption(option);
}

