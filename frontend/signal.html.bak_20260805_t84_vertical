// 注意: 卖出规则文案不在此配置——由 buildSellRuleText(pos) 从持仓实际参数
// (sell_mode/trailing_pp/tp_price/sl_price/expire_date)动态生成, 避免参数与文案漂移(Task#16)
function fmtRulePct(x) {
  const r = Math.round(x * 10) / 10;
  return (r % 1 === 0) ? r.toFixed(0) : r.toFixed(1);
}

function buildSellRuleText(pos) {
  const buy = pos.buy_price;
  const parts = [];
  if ((pos.sell_mode || 'fixed') === 'timed') {
    // Task#36: timed定时了结(B2-A), 无盘中止盈止损
    const at = pos.sell_at || {};
    if (at.date && at.time) {
      const d = at.date.split('-');
      parts.push(parseInt(d[1]) + '/' + parseInt(d[2]) + ' ' + at.time + ' 定时卖出');
    } else {
      parts.push('次日10:30定时卖出');
    }
    parts.push('无盘中止盈止损');
    return parts.join(' / ');
  }
  if ((pos.sell_mode || 'fixed') === 'trailing') {
    parts.push(pos.trailing_pp != null
      ? '高点回落' + fmtRulePct(pos.trailing_pp) + '%止盈'
      : '高点回落止盈(参数缺失)');
  } else if (pos.tp_price && buy > 0) {
    parts.push('涨' + fmtRulePct((pos.tp_price / buy - 1) * 100) + '%止盈');
  }
  if (pos.sl_price && buy > 0) {
    parts.push('跌' + fmtRulePct((1 - pos.sl_price / buy) * 100) + '%止损');
  }
  if (pos.expire_date) {
    const p = pos.expire_date.split('-');
    parts.push('到期日: ' + parseInt(p[1]) + '/' + parseInt(p[2]));
  } else {
    parts.push('到期日: --');
  }
  return parts.length > 1 ? parts.join(' / ') : '--';
}

