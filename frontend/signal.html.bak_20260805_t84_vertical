          html += '<div class="cand-item">' +
            '<div class="cand-row"><span class="cand-code">' + c.code + '</span><span class="cand-name">' + c.name + boughtTag + '</span></div>' +
            '<div class="cand-row"><span class="cand-condition">' + conditionHtml + '</span>' +
            '<span style="font-family:var(--mono);font-size:11px;color:var(--text2);" data-cand-code="' + c.code + '"></span></div>' +
            '</div>';
        });
      }
      html += '</div></div>';
    });

    html += '</div>';

    // 添加时间感知的底部提示
    html += getCandidatesFooter();

    list.innerHTML = html;
  } catch(e) {
    document.getElementById('candidatesList').innerHTML = '<div class="empty-state"><div class="msg">加载失败</div></div>';
  }
