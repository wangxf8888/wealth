    // 构建持仓代码集合，用于标记"已买入"
    const holdingCodes = new Set(positionsData.map(p => p.code));

    // 构建决策索引: code -> {recommended, open, open_rate_pct}
    const decisionMap = {};
    if (decisionData && decisionData.strategies) {
      Object.values(decisionData.strategies).forEach(function(strat) {
        (strat.recommendations || []).forEach(function(r) {
          decisionMap[r.code] = { status: 'buy', open: r.open, open_rate_pct: r.open_rate_pct, buy_price: r.buy_price };
        });
        if (strat.with_open_price > 0 && strat.meet_condition) {
          strat.meet_condition.forEach(function(m) {
            if (!decisionMap[m.code]) {
              decisionMap[m.code] = { status: 'meet', open: m.open, open_rate_pct: m.open_rate_pct };
            }
          });
        }
      });
    }
    const hasDecision = decisionData !== null;
    const decWithOpen = hasDecision && Object.values(decisionData.strategies || {}).some(function(s) { return s.with_open_price > 0; });

    info.textContent = '信号日: ' + (d.signal_date || '--') + ' | 交易日: ' + (d.trade_date || '--') +
      (hasDecision ? ' | 决策: ' + (decisionData.decided_at || '').split(' ')[1] : '');

