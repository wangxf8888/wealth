    // Pie Chart
    initPieChart(holdings, 1000000);

    // Render 5 Slots - always show all
    const posEl = document.getElementById('positionsTable');
    const totalNav = d.account?.total_nav || 1000000;
    const closedTrades = d.closed_trades || [];
    const today = new Date();
    const todayStr = today.getFullYear() + '-' +
      String(today.getMonth() + 1).padStart(2, '0') + '-' +
      String(today.getDate()).padStart(2, '0');

    let html = '<table class="data-table"><thead><tr>' +
      '<th>资金位/策略</th><th>持仓标的</th><th>买入价</th><th>现价</th>' +
      '<th>盈亏</th><th>卖出规则</th>' +
      '</tr></thead><tbody>';

    // 行序: 持仓 -> 今日已卖 -> 纯空闲; 资金位按显示顺序编号P1~P5(槽位本身无策略属性)
    let rowNo = 0;
    function pBadge() { rowNo += 1; return '<span class="slot-badge slot-p">P' + rowNo + '</span>'; }

    holdings.forEach(function(pos) {
        // 卖出规则文案: 从持仓实际参数动态生成(禁止硬编码, 见Task#16)
        const sellRule = buildSellRuleText(pos);
        // T+1角标: 今日买入禁卖, 触线不卖不是止盈失灵——下一交易日起恢复正常卖出
        const t1Tip = (pos.sell_mode === 'timed')
          ? '今日买入, T+1规则禁卖; 将按定时规则到点卖出'
          : '今日买入, T+1规则禁卖; 下一交易日9:30起触线即卖';
        const t1Badge = (pos.buy_date === todayStr)
          ? ' <span style="display:inline-block;padding:0 4px;border:1px solid var(--amber);border-radius:3px;color:var(--amber);font-size:10px;white-space:nowrap;" title="' + t1Tip + '">T+1 明日可卖</span>' : '';
        html += '<tr>' +
          '<td>' + pBadge() + ' ' + strategyShortName(pos.strategy) + '</td>' +
          '<td style="color:var(--blue);">' + pos.code + ' <span style="color:var(--text);font-size:11px;">' + (pos.name || '') + '</span>' + t1Badge + '</td>' +
          '<td>¥' + (typeof pos.buy_price === 'number' ? pos.buy_price.toFixed(2) : '--') + '</td>' +
          '<td data-code="' + pos.code + '" data-field="price">--</td>' +
          '<td data-code="' + pos.code + '" data-field="pnl" data-buy="' + pos.buy_price + '" data-tp="' + (pos.tp_price || '') + '" data-sl="' + (pos.sl_price || '') + '" data-mode="' + (pos.sell_mode || 'fixed') + '" data-peak="' + (pos.peak_price || pos.buy_price || '') + '" data-trailing="' + (pos.trailing_pp || '') + '"><span>--</span>' +
          buildTargetsHtml(pos.sell_mode, pos.tp_price, pos.sl_price,
                           pos.peak_price || pos.buy_price, pos.buy_price,
                           pos.trailing_pp) +
          '</td>' +
          '<td style="font-size:11px;color:var(--text2);white-space:nowrap;">' + sellRule + '</td>' +
          '</tr>';
    });

    // 今日已卖(槽位今日释放): 策略名从成交记录strategy字段读, 最多补到TOTAL_SLOTS行
    closedTrades.filter(function(t) { return t.sell_date === todayStr; })
      .slice(0, Math.max(0, TOTAL_SLOTS - holdings.length))
      .forEach(function(todaySold) {
          const pnl = todaySold.pnl_pct || 0;
          const pnlStr = (pnl >= 0 ? '+' : '') + pnl.toFixed(2) + '%';
          const pnlCls = pnl >= 0 ? 'badge-profit' : 'badge-loss';
          const reasonMap = {take_profit:'止盈触发', stop_loss:'止损触发', trailing_stop:'追踪止盈', max_hold:'持仓到期', expired:'到期卖出'};
          const reason = reasonMap[todaySold.sell_reason] || todaySold.sell_reason || '';
          html += '<tr class="sold-row">' +
            '<td>' + pBadge() + ' ' + strategyShortName(todaySold.strategy) + '</td>' +
            '<td style="color:var(--text2);">' + todaySold.code + ' <span style="font-size:11px;">' + (todaySold.name || '') + '</span></td>' +
            '<td class="sold-status">已卖出</td>' +
            '<td class="sold-detail">买¥' + todaySold.buy_price.toFixed(2) + ' 卖¥' + todaySold.sell_price.toFixed(2) + '</td>' +
            '<td><span class="badge ' + pnlCls + '">' + pnlStr + '</span></td>' +
            '<td class="sold-reason">' + reason + '</td>' +
            '</tr>';
      });

    // 纯空闲槽: 只显资金位编号+空闲, 不显任何策略名(用户裁决: 空仓时不标记策略)
    while (rowNo < TOTAL_SLOTS) {
      html += '<tr class="idle-row">' +
        '<td>' + pBadge() + '</td>' +
        '<td colspan="5" class="idle-status">空闲</td>' +
        '</tr>';
    }

    html += '</tbody></table>';
    posEl.innerHTML = html;

    // Refresh quotes if any holdings
    if (holdings.length > 0) {
      refreshQuotes();
    }

    // History table - now loaded from new API separately
  } catch(e) {
    document.getElementById('positionsTable').innerHTML = '<div class="empty-state"><div class="msg">加载失败: ' + e.message + '</div></div>';
  }
}

