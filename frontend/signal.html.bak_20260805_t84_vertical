function getCandidatesTitle(data) {
  const now = new Date();
  const hour = now.getHours();
  // 使用本地日期，避免 toISOString() 的时区偏移问题
  const todayStr = now.getFullYear() + '-' +
    String(now.getMonth() + 1).padStart(2, '0') + '-' +
    String(now.getDate()).padStart(2, '0');

  // 从API数据中取signal_date和trade_date
  const signalDate = data ? (data.signal_date || '') : '';
  const tradeDate = data ? (data.trade_date || '') : '';

  if (!signalDate || !tradeDate) {
    // 无数据，按时间推测
    if (hour < 15) return '今日候选股';
    if (hour < 22) return '明日候选股（预计22:00更新）';
    return '明日候选股（等待更新...）';
  }

  // 基于实际数据判断
  if (tradeDate === todayStr) {
    // 交易日是今天 → 今日候选
    return '今日候选股';
  } else if (tradeDate > todayStr) {
    // 交易日在未来 → 明日候选
    if (signalDate === todayStr) {
      // 信号日就是今天，说明22:00已成功跑完
      return '明日候选股（已更新）';
    } else {
      // 信号日不是今天，数据可能提前生成
      return '明日候选股（已更新）';
    }
  } else {
    // 交易日已过 → 数据过期
    if (hour >= 17) {
      return '明日候选股（等待更新...）';
    } else if (hour >= 15) {
      return '明日候选股（预计17:00更新）';
    } else {
      return '今日候选股（数据待更新）';
    }
  }
}

