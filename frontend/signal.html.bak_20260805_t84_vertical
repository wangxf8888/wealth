<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIWealth · 实盘交易信号系统</title>
<script src="/echarts.min.js"></script>
<style>
:root {
  --bg: #0a0e17;
  --bg2: #0f1520;
  --bg3: #141d2b;
  --border: #1a2436;
  --text: #e8edf5;
  --text2: #7a8ba5;
  --text3: #4a5a72;
  --gold: #d4a534;
  --gold-dim: #b8912a;
  --green: #00c87a;
  --green-bg: rgba(0,200,122,0.12);
  --red: #ff4757;
  --red-bg: rgba(255,71,87,0.12);
  --blue: #38b6ff;
  --blue-bg: rgba(56,182,255,0.12);
  --amber: #f0a030;
  --radius: 10px;
  --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', sans-serif;
  --mono: 'Menlo', 'Consolas', 'Monaco', monospace;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { background: var(--bg); color: var(--text); font-family: var(--font); min-height: 100vh; }

/* Header */
.header {
  background: var(--bg2); border-bottom: 1px solid var(--border);
  padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;
  position: sticky; top: 0; z-index: 100;
}
.header h1 { font-size: 18px; font-weight: 700; color: var(--gold); }
.header h1 span { color: var(--text3); font-weight: 300; font-size: 13px; margin-left: 8px; }
.header-right { display: flex; gap: 16px; align-items: center; }
.header-right a {
  color: var(--text2); text-decoration: none; font-size: 13px; padding: 6px 12px;
  border-radius: 4px; transition: all .2s;
}
.header-right a:hover { color: var(--gold); background: rgba(212,165,52,0.1); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); display: inline-block; margin-right: 4px; animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{opacity:1}50%{opacity:.4} }
.market-tag { font-size: 11px; padding: 3px 8px; border-radius: 4px; font-family: var(--mono); }
.market-tag.open { background: var(--green-bg); color: var(--green); }
.market-tag.closed { background: rgba(122,139,165,0.12); color: var(--text3); }

/* Container */
.container { max-width: 1600px; margin: 0 auto; padding: 20px; }

/* Cards */
.card {
  background: var(--bg2); border: 1px solid var(--border); border-radius: var(--radius);
  padding: 20px; transition: border-color .2s;
}
.card:hover { border-color: rgba(212,165,52,0.3); }
.card-header {
  font-size: 13px; color: var(--text2); font-weight: 600; margin-bottom: 16px;
  display: flex; align-items: center; gap: 8px; justify-content: space-between;
}
.card-header .title { display: flex; align-items: center; gap: 8px; }
.card-header .title::before { content: ''; width: 3px; height: 14px; background: var(--gold); border-radius: 2px; }

/* KPI Strip */
.kpi-strip {
  display: flex; gap: 24px; padding: 12px 20px; background: var(--bg2);
  border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 16px;
  align-items: center; flex-wrap: wrap;
}
.kpi-item { text-align: center; }
.kpi-label { font-size: 11px; color: var(--text3); margin-bottom: 2px; }
.kpi-value { font-size: 20px; font-weight: 700; font-family: var(--mono); }
.kpi-value.profit { color: var(--red); }
.kpi-value.loss { color: var(--green); }
.kpi-value.neutral { color: var(--text2); }
/* 最大回撤预警色: 回撤手册L1(10%)橙/L2(20%)红同色系 */
.kpi-value.dd-warn { color: #ff9f43; }
.kpi-value.dd-crit { color: var(--red); }
/* Task#82: KPI数值变动闪烁反馈 */
@keyframes kpiFlash { 0% { background: rgba(56,182,255,0.35); } 100% { background: transparent; } }
.kpi-value.kpi-flash { animation: kpiFlash 0.8s ease-out; border-radius: 4px; }
.kpi-data-time { text-align: right; font-size: 11px; color: var(--text3); font-family: var(--mono); margin: -6px 0 10px; }

/* 指数行情栏 */
.index-strip {
  display: flex; gap: 18px; padding: 8px 16px; background: var(--bg2);
  border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 16px;
  align-items: center; flex-wrap: wrap; font-family: var(--mono); font-size: 12px;
}
.idx-item { display: flex; align-items: baseline; gap: 5px; white-space: nowrap; }
.idx-name { color: var(--text3); font-size: 11px; }
.idx-px { font-weight: 700; }
.idx-chg { font-size: 11px; }
.idx-up { color: var(--red); }
.idx-down { color: var(--green); }
.idx-flat { color: var(--text2); }
.idx-mkt { font-size: 9px; padding: 0 3px; border-radius: 3px; vertical-align: 1px; }
.idx-mkt.open { background: var(--green-bg); color: var(--green); }
.idx-mkt.closed { background: rgba(122,139,165,0.12); color: var(--text3); }
.idx-caliber { font-size: 9px; color: var(--text3); }
.idx-breadth { margin-left: auto; white-space: nowrap; font-size: 12px; }

/* 当日交易事件滚动栏 (Task#84) */
.events-strip {
  overflow: hidden; position: relative; padding: 8px 0; background: var(--bg2);
  border: 1px solid var(--border); border-radius: var(--radius);
  font-family: var(--mono); font-size: 12px; white-space: nowrap;
}
.events-track { display: inline-block; white-space: nowrap; will-change: transform; }
.events-track.scrolling { animation: evtScroll var(--evt-dur, 30s) linear infinite; }
.events-strip:hover .events-track.scrolling { animation-play-state: paused; }
@keyframes evtScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
.evt-item { display: inline-flex; align-items: baseline; gap: 6px; padding: 0 22px; }
.evt-time { color: var(--text3); font-size: 11px; }
.evt-name { color: var(--text); font-weight: 600; }
.evt-px { color: var(--text2); }
.evt-act-buy { color: var(--red); font-weight: 700; }
.evt-act-sell { color: var(--green); font-weight: 700; }
.evt-pnl-profit { color: var(--red); font-weight: 600; }
.evt-pnl-loss { color: var(--green); font-weight: 600; }
.evt-strat { color: var(--text3); font-size: 11px; }
.evt-note { color: var(--text3); font-size: 11px; }
.evt-shadow-badge {
  font-size: 9px; padding: 0 4px; border-radius: 3px; vertical-align: 1px;
  background: rgba(122,139,165,0.18); color: var(--text3);
}
.evt-empty { color: var(--text3); padding: 0 16px; }

/* Section margins */
.section { margin-bottom: 20px; }

/* Position grid */
.pos-grid { display: grid; grid-template-columns: 320px 1fr; gap: 16px; }
@media (max-width: 1024px) { .pos-grid { grid-template-columns: 1fr; } }

/* Table */
.data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.data-table th {
  text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border);
  color: var(--text3); font-weight: 500; font-size: 11px; text-transform: uppercase;
  letter-spacing: 0.5px;
}
.data-table td { padding: 10px 12px; border-bottom: 1px solid rgba(26,36,54,0.4); font-family: var(--mono); font-size: 12px; }
.data-table tr:hover td { background: rgba(56,182,255,0.03); }

/* Badges */
.badge { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 11px; font-weight: 600; font-family: var(--mono); }
.badge-profit { background: var(--red-bg); color: var(--red); }
.badge-loss { background: var(--green-bg); color: var(--green); }
.badge-hold { background: var(--blue-bg); color: var(--blue); }
.badge-tp { background: var(--red-bg); color: var(--red); }
.badge-sl { background: var(--green-bg); color: var(--green); }
.badge-expired { background: rgba(122,139,165,0.15); color: var(--text2); }
.badge-strategy { font-size: 11px; color: var(--amber); background: rgba(240,160,48,0.12); padding: 2px 6px; border-radius: 3px; }

/* Candidates */
.cand-list { max-height: 360px; overflow-y: auto; }
.cand-item {
  display: flex; flex-direction: column; align-items: flex-start; gap: 3px;
  padding: 8px 12px; border-bottom: 1px solid rgba(26,36,54,0.4); transition: background .15s;
}
.cand-item:hover { background: rgba(212,165,52,0.04); }
.cand-item .cand-row { display: flex; align-items: center; gap: 8px; width: 100%; }
.cand-code { font-family: var(--mono); font-size: 12px; color: var(--blue); }
.cand-name { font-size: 12px; color: var(--text); }
.cand-condition { font-size: 11px; color: var(--text3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Strategy Candidate Cards */
.cand-strategies-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12px; }
.cand-strategy-card {
  background: #1a1f2e; border: 1px solid var(--border); border-radius: var(--radius);
  overflow: hidden; transition: border-color .2s;
  flex: 1 1 0; min-width: 180px; max-width: calc(20% - 10px);
}
.cand-strategy-card:hover { border-color: rgba(212,165,52,0.3); }
.cand-strategy-card.s1 { border-left: 3px solid #ff6b6b; }
.cand-strategy-card.s2 { border-left: 3px solid #38b6ff; }
.cand-strategy-card.s3 { border-left: 3px solid #ffd93d; }
.cand-strategy-card.s4 { border-left: 3px solid #6bcb77; }
.cand-strategy-card.s5 { border-left: 3px solid #c084fc; }
.cand-strategy-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 14px; border-bottom: 1px solid rgba(26,36,54,0.6);
}
.cand-strategy-title { font-size: 13px; font-weight: 600; color: var(--text); }
.cand-strategy-title .slot-tag { font-family: var(--mono); margin-right: 6px; font-weight: 700; }
.cand-strategy-title .slot-tag.s1 { color: #ff6b6b; }
.cand-strategy-title .slot-tag.s2 { color: #38b6ff; }
.cand-strategy-title .slot-tag.s3 { color: #ffd93d; }
.cand-strategy-title .slot-tag.s4 { color: #6bcb77; }
.cand-strategy-title .slot-tag.s5 { color: #c084fc; }
.cand-strategy-count { font-size: 11px; color: var(--text3); font-family: var(--mono); }
.cand-strategy-body { padding: 4px 0; max-height: 400px; overflow-y: auto; }
.cand-strategy-empty { padding: 16px 14px; text-align: center; color: var(--text3); font-size: 12px; }
@media (max-width: 1200px) { .cand-strategy-card { max-width: calc(33.33% - 8px); } }
@media (max-width: 768px) { .cand-strategy-card { max-width: 100%; } }

/* Slot badges */
.slot-badge {
  display: inline-block; padding: 2px 6px; border-radius: 3px;
  font-size: 11px; font-weight: 700; font-family: var(--mono);
  margin-right: 4px;
}
.slot-badge.slot-s1 { background: rgba(255,107,107,0.15); color: #ff6b6b; }
.slot-badge.slot-s2 { background: rgba(56,182,255,0.15); color: #38b6ff; }
.slot-badge.slot-s3 { background: rgba(255,217,61,0.15); color: #ffd93d; }
.slot-badge.slot-s4 { background: rgba(107,203,119,0.15); color: #6bcb77; }
.slot-badge.slot-s5 { background: rgba(192,132,252,0.15); color: #c084fc; }
.slot-badge.slot-p { background: rgba(122,139,165,0.15); color: var(--text2); }

/* Idle slot row */
.idle-row td { opacity: 0.55; }
.idle-status { color: var(--text3) !important; font-style: italic; text-align: center; }
.idle-capital { color: var(--text3) !important; font-size: 11px; }

/* Sold slot row */
.sold-row td { background: rgba(240,160,48,0.06); }
.sold-status { color: var(--amber) !important; font-weight: 600; font-size: 12px; }
.sold-detail { color: var(--text2) !important; font-size: 11px; }
.sold-reason { color: var(--text3) !important; font-size: 11px; font-style: italic; }

/* Position profit/loss */
.pos-profit { color: var(--red); font-weight: 600; }
.pos-loss { color: var(--green); font-weight: 600; }

/* Position TP/SL targets */
.position-targets {
  font-size: 11px;
  margin-top: 4px;
  line-height: 1.4;
}
.position-targets .tp { color: #f44336; }
.position-targets .sl { color: #4caf50; }
.position-targets .divider { color: var(--text3); margin: 0 4px; }

/* Candidates footer & bought tag */
.candidates-footer {
  text-align: center;
  color: #888;
  font-size: 13px;
  padding: 12px 0;
  border-top: 1px solid #333;
  margin-top: 12px;
}
.bought-tag {
  background: #0f3460;
  color: #00d4ff;
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 11px;
  margin-left: 4px;
}

/* Empty state */
.empty-state { text-align: center; padding: 40px 20px; color: var(--text3); }
.empty-state .icon { font-size: 36px; margin-bottom: 12px; opacity: 0.5; }
.empty-state .msg { font-size: 14px; }

/* Advice badges */
.advice-hold { color: var(--blue); }
.advice-tp { color: var(--red); }
.advice-sl { color: var(--green); }

/* Mode Tabs */
.mode-tabs {
  display: flex; gap: 4px; margin-bottom: 14px;
  background: var(--bg3); border-radius: 8px; padding: 4px; width: fit-content;
}
.mode-tab {
  padding: 7px 20px; border: none; border-radius: 6px;
  background: transparent; color: var(--text3); cursor: pointer;
  font-size: 13px; font-weight: 600; transition: all .2s;
  font-family: var(--font);
}
.mode-tab:hover { color: var(--text2); }
.mode-tab.active {
  background: var(--bg2); color: var(--gold);
  box-shadow: 0 1px 4px rgba(0,0,0,0.2);
}

/* Footer */
.footer { text-align: center; padding: 20px; color: var(--text3); font-size: 11px; margin-top: 20px; border-top: 1px solid var(--border); }

/* Responsive */
@media (max-width: 768px) {
  .pos-grid { grid-template-columns: 1fr; }
  .kpi-strip { gap: 12px; justify-content: center; }
  .container { padding: 12px; }
}
</style>
</head>
