function updateNavRealtime(quotesData) {
  if (currentMode !== 'live') return;
  if (livePositions.length === 0) return;

  // 1. 重新计算总资产 = 现金 + sum(每个持仓当前市值) (Task#82口径对齐)
  let marketValue = 0;
  let pieData = [];
  livePositions.forEach(function(p) {
    const quote = quotesData[p.code];
    const currentPrice = (quote && quote.price > 0) ? quote.price : p.buy_price;
    const posValue = p.buy_amount * (currentPrice / p.buy_price);
    marketValue += posValue;
    pieData.push({ name: p.code.split('.')[1] || p.code, value: Math.round(posValue) });
  });

  const currentNav = liveCash + marketValue;
  const returnPct = (currentNav / liveInitialCapital - 1) * 100;

  // 2/3. KPI(总资产/累计收益)改由 refreshHeaderStats 快照轮询统一更新(Task#82),
  // 此处不再双写, 避免两套口径互相覆盖闪跳。

  // 4. 更新资金曲线最后一个点
  if (navChartInstance && liveNavData.length > 0) {
    const lastIdx = liveNavData.length - 1;
    liveNavData[lastIdx].nav = Math.round(currentNav);
    liveNavData[lastIdx].return_pct = parseFloat(returnPct.toFixed(2));

    // 更新ECharts
    const returns = liveNavData.map(d => d.return_pct);
    const navs = liveNavData.map(d => d.nav);
    const lastReturn = returns[lastIdx];
    const lineColor = lastReturn >= 0 ? '#ff4757' : '#00c87a';
    navChartInstance.setOption({
      series: [{
        data: returns,
        lineStyle: { color: lineColor },
        itemStyle: { color: lineColor },
        areaStyle: { color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
          { offset: 0, color: lastReturn >= 0 ? 'rgba(255,71,87,0.2)' : 'rgba(0,200,122,0.2)' },
          { offset: 1, color: 'rgba(0,0,0,0)' }
        ]) }
      }]
    });

    // 更新摘要文字
    const summaryEl = document.getElementById('navSummary');
    const cls = lastReturn >= 0 ? 'var(--red)' : 'var(--green)';
    summaryEl.innerHTML = '实盘收益: <span style="color:' + cls + ';font-weight:700;">' +
      (lastReturn >= 0 ? '+' : '') + lastReturn.toFixed(2) + '%</span> · 总资产: ¥' + Math.round(currentNav).toLocaleString() +
      ' <span style="color:var(--text3);font-size:11px;">(2026-07-22起 实盘动态再平衡)</span>';
  }

  // 5. 更新饼图（持仓市值分配）
  if (pieChartInstance && pieData.length > 0) {
    pieData.push({ name: '现金', value: Math.round(liveCash), itemStyle: { color: '#2a3a52' } });
    pieChartInstance.setOption({
      series: [{ data: pieData }]
    });
  }
}

// ===== Task#82: 头部统计盘中实时刷新 =====
// 数据源: intraday_monitor守护进程每10s写的 intraday_snapshot.json(持仓实时价)
//        + positions.json(现金/持仓成本/已平仓, 只读, 经 frontend/data 软链静态直出)
// 口径: 总资产=现金+Σ(持仓股数×实时价); 股数=buy_amount/buy_price;
//       胜率含浮盈=(盈利平仓笔+浮盈持仓笔)/总笔数 (浮盈计胜、浮亏计负)
const KPI_LIVE_START_DATE = '2026-07-22';  // 与 /api/positions 实盘统计口径一致
const KPI_POLL_MS = 12000;                 // 盘中轮询间隔(快照本身10s一写)
let kpiClosedRendered = false;             // 非交易时段收盘口径已渲染, 停止轮询

function setKpiValue(id, text, cls) {
  const el = document.getElementById(id);
  if (!el) return;
  const changed = el.textContent !== text;
  el.textContent = text;
  el.className = 'kpi-value ' + (cls || 'neutral');
  if (changed) {
    // 重触发闪烁动画(先移除再强制reflow)
    void el.offsetWidth;
    el.classList.add('kpi-flash');
  }
}

async function refreshHeaderStats() {
  if (currentMode !== 'live') return;
  const inSession = isTradeSession();
  if (!inSession && kpiClosedRendered) return;  // 收盘后/非交易日: 渲染一次后停止轮询
  try {
    const bust = '?_=' + Date.now();
    const [snap, pos, dd] = await Promise.all([
      fetchJSON('/data/intraday_snapshot.json' + bust).catch(function() { return null; }),
      fetchJSON('/data/positions.json' + bust),
      fetchJSON('/data/drawdown_state.json' + bust).catch(function() { return null; })
    ]);

    const account = pos.account || {};
    const cash = account.cash || 0;
    const initial = account.initial_capital || 1000000;
    const holdings = (pos.positions || []).filter(function(p) { return p.status === 'holding'; });
    const closed = (pos.closed_trades || []).filter(function(t) { return (t.buy_date || '') >= KPI_LIVE_START_DATE; });

    // 快照实时价索引 {code: price}(守护进程10s一写); 缺失时回退buy_price
    const snapPrices = {};
    const snapTime = (snap && snap.updated_at) || null;
    if (snap && snap.positions) {
      snap.positions.forEach(function(r) { if (r.price > 0) snapPrices[r.code] = r.price; });
    }

    // 总资产 = 现金 + Σ(持仓股数×实时价)
    let nav = cash, holdingWins = 0;
    holdings.forEach(function(p) {
      if (!(p.buy_price > 0)) return;
      const px = snapPrices[p.code] || p.buy_price;
      nav += (p.buy_amount / p.buy_price) * px;
      if (px >= p.buy_price) holdingWins++;  // 浮盈(含平)计胜, 浮亏计负
    });
    const returnPct = (nav / initial - 1) * 100;
    const closedWins = closed.filter(function(t) { return (t.pnl_pct || 0) > 0; }).length;
    const totalTrades = closed.length + holdings.length;
    const winRate = totalTrades > 0 ? (closedWins + holdingWins) / totalTrades * 100 : null;

    // 最大回撤 = max(nav_history历史逐日回撤最大值, 当前实时回撤(hwm−实时nav)/hwm)
    // 新高日: nav>hwm时当前回撤clamp为0防负数
    let maxDD = null;
    if (dd && Array.isArray(dd.nav_history) && dd.nav_history.length) {
      let runHwm = 0, histMax = 0;
      dd.nav_history.forEach(function(row) {
        const v = row[1];
        if (v > runHwm) runHwm = v;
        else if (runHwm > 0) histMax = Math.max(histMax, (runHwm - v) / runHwm);
      });
      const hwm = Math.max(dd.hwm || 0, runHwm);
      const curDD = hwm > 0 ? Math.max(0, (hwm - nav) / hwm) : 0;
      maxDD = Math.max(histMax, curDD) * 100;
    }

    const cls = returnPct >= 0 ? 'profit' : 'loss';
    setKpiValue('kpiNav', '¥' + Math.round(nav).toLocaleString(), cls);
    setKpiValue('kpiReturn', (returnPct >= 0 ? '+' : '') + returnPct.toFixed(2) + '%', cls);
    setKpiValue('kpiHolding', String(holdings.length), 'neutral');
    setKpiValue('kpiTrades', totalTrades + '(含持仓)', 'neutral');
    setKpiValue('kpiWinRate', winRate == null ? '--' : winRate.toFixed(1) + '%', 'neutral');
    document.getElementById('kpiMaxDDItem').style.display = '';
    setKpiValue('kpiMaxDD', maxDD == null ? '--' : maxDD.toFixed(1) + '%',
      maxDD == null ? 'neutral' : maxDD >= 20 ? 'dd-crit' : maxDD >= 10 ? 'dd-warn' : 'neutral');

    // 数据时间戳 + 守护进程停更兜底提示
    const tsEl = document.getElementById('kpiDataTime');
    if (tsEl) {
      if (snapTime) {
        const ageSec = (Date.now() - new Date(snapTime.replace(' ', 'T')).getTime()) / 1000;
        if (inSession && ageSec > 60) {
          tsEl.innerHTML = '<span style="color:var(--amber);">⚠ 盘中快照停更 · 数据截至 ' + snapTime.slice(11) + '</span>';
        } else if (inSession) {
          tsEl.textContent = '● 实时 · 持仓快照 ' + snapTime.slice(11) + ' (10s更新)';
        } else {
          tsEl.textContent = '○ 收盘口径 · 数据截至 ' + snapTime;
        }
      } else {
        tsEl.textContent = '快照缺失 · 按持仓成本价展示(positions.json口径)';
      }
    }
    if (!inSession) kpiClosedRendered = true;
  } catch(e) { console.error('header stats error', e); }
}

// ===== Realtime Quotes =====
async function refreshQuotes() {
  const priceCells = document.querySelectorAll('[data-code][data-field="price"]');
  const codes = new Set();
  priceCells.forEach(cell => codes.add(cell.dataset.code));
  const candCodes = document.querySelectorAll('[data-cand-code]');
  candCodes.forEach(el => codes.add(el.dataset.candCode));
  if (codes.size === 0) return;

  try {
    const resp = await fetchJSON('/api/realtime_quotes?codes=' + Array.from(codes).join(','));
    const data = resp.data || {};

    priceCells.forEach(cell => {
      const code = cell.dataset.code;
      const quote = data[code];
      if (!quote) return;
      const cls = quote.change_pct > 0 ? 'color:var(--red)' : quote.change_pct < 0 ? 'color:var(--green)' : 'color:var(--text2)';
      // 括号内=当日涨跌幅(相对昨收, 行情源change_pct直出)——区别于"盈亏"列的相对买入价浮盈
      const chg = (quote.change_pct != null)
        ? ' (' + (quote.change_pct >= 0 ? '+' : '') + quote.change_pct.toFixed(2) + '%)' : '';
      cell.innerHTML = '<span style="' + cls + '">' + quote.price.toFixed(2) + chg + '</span>';
    });

    // PnL cells
    document.querySelectorAll('[data-code][data-field="pnl"]').forEach(cell => {
      const code = cell.dataset.code;
      const buyPrice = parseFloat(cell.dataset.buy);
      const quote = data[code];
      if (!quote || !buyPrice) return;
      const pnl = ((quote.price - buyPrice) / buyPrice * 100).toFixed(2);
      const cls = pnl >= 0 ? 'badge-profit' : 'badge-loss';
      let html = '<span class="badge ' + cls + '">' + (pnl >= 0 ? '+' : '') + pnl + '%</span>';
      const tp = cell.dataset.tp;
      const sl = cell.dataset.sl;
      const mode = cell.dataset.mode || 'fixed';
      if (mode === 'trailing') {
        // 实时上移peak: 存量peak vs 今日盘中最高 vs 现价（只升不降）
        let peak = parseFloat(cell.dataset.peak) || buyPrice;
        if (quote.high && quote.high > peak) peak = quote.high;
        if (quote.price > peak) peak = quote.price;
        cell.dataset.peak = peak;
        // trailing_pp必须来自持仓记录(data-trailing); 缺失时传null→显示?pp, 不静默按2pp计算
        html += buildTargetsHtml('trailing', null, sl ? parseFloat(sl) : null,
                                 peak, buyPrice,
                                 parseFloat(cell.dataset.trailing) || null);
      } else if (tp || sl) {
        html += buildTargetsHtml('fixed', tp ? parseFloat(tp) : null,
                                 sl ? parseFloat(sl) : null, null, null, null);
      }
      cell.innerHTML = html;
    });

    // Advice cells
    document.querySelectorAll('[data-code][data-field="advice"]').forEach(cell => {
      const code = cell.dataset.code;
      const buyPrice = parseFloat(cell.dataset.buy);
      const slPrice = parseFloat(cell.dataset.sl);
      const quote = data[code];
      if (!quote || !buyPrice) return;
      const price = quote.price;
      const mode = cell.dataset.mode || 'fixed';
      if (mode === 'trailing') {
        // trailing建议: 现价跌破回落止盈触发价 → 立即卖出
        let peak = parseFloat(cell.dataset.peak) || buyPrice;
        if (quote.high && quote.high > peak) peak = quote.high;
        if (quote.price > peak) peak = quote.price;
        // pp必须来自持仓记录(data-trailing); 缺失时不猜默认值, trig为null仅保留止损判断
        const pp = parseFloat(cell.dataset.trailing) || null;
        const trig = trailingTrigger(peak, buyPrice, pp);
        if (slPrice && price <= slPrice) {
          cell.innerHTML = '<span class="advice-sl">跌破止损，立即卖出</span>';
        } else if (peak > buyPrice && trig && price <= trig) {
          cell.innerHTML = '<span class="advice-tp">触发回落止盈，立即卖出</span>';
        } else if (peak > buyPrice && trig && (price - trig) / price < 0.01) {
          cell.innerHTML = '<span class="advice-tp">接近回落止盈(' + trig.toFixed(2) + ')</span>';
        } else {
          cell.innerHTML = '<span class="advice-hold">继续持有</span>';
        }
        return;
      }
      const tpPrice = parseFloat(cell.dataset.tp);
      const tpDist = ((tpPrice - price) / price * 100).toFixed(1);
      const slDist = ((price - slPrice) / price * 100).toFixed(1);
      if (tpPrice && parseFloat(tpDist) <= 2) {
        cell.innerHTML = '<span class="advice-tp">接近止盈</span>';
      } else if (parseFloat(slDist) <= 2) {
        cell.innerHTML = '<span class="advice-sl">接近止损</span>';
      } else {
        cell.innerHTML = '<span class="advice-hold">继续持有</span>';
      }
    });

    // Candidate realtime
    candCodes.forEach(el => {
      const code = el.dataset.candCode;
      const quote = data[code];
      if (!quote) return;
      const cls = quote.change_pct > 0 ? 'color:var(--red)' : quote.change_pct < 0 ? 'color:var(--green)' : 'color:var(--text2)';
      el.innerHTML = '<span style="' + cls + '">' + quote.price.toFixed(2) + ' (' + (quote.change_pct >= 0 ? '+' : '') + quote.change_pct.toFixed(2) + '%)</span>';
    });

    // 联动更新总资产、收益率、资金曲线、饼图
    updateNavRealtime(data);
  } catch(e) { console.error('quotes error', e); }
}

// ===== 卖出目标价展示（fixed=固定止盈; trailing=动态回落止盈价，随高点上移） =====
function trailingTrigger(peak, buy, pp) {
  // 回落止盈触发价 = 持有期最高价 - 买入价×pp%（与回测/实盘引擎同一公式）
  if (!peak || !buy || !pp) return null;
  return peak - buy * pp / 100;
}

function buildTargetsHtml(mode, tpPrice, slPrice, peak, buy, trailingPp) {
  if (mode === 'trailing') {
    // trailingPp必须来自持仓记录, 缺失时不猜默认值(否则触发价与实际执行不一致)
    const trig = trailingTrigger(peak, buy, trailingPp);
    const trigStr = trig ? trig.toFixed(2) : '--';
    const peakStr = peak ? Number(peak).toFixed(2) : '--';
    const ppStr = (trailingPp != null && trailingPp !== '') ? trailingPp + 'pp' : '?pp';
    return '<div class="position-targets">' +
      '<span class="tp">回落止盈 ¥' + trigStr + '<span style="color:var(--text3);">（高点' + peakStr + '↓' + ppStr + '，随新高上移）</span></span>' +
      '<span class="divider">|</span>' +
      '<span class="sl">硬止损 ¥' + (slPrice ? Number(slPrice).toFixed(2) : '--') + '</span></div>';
  }
  if (tpPrice || slPrice) {
    return '<div class="position-targets"><span class="tp">止盈 ¥' +
      (tpPrice ? Number(tpPrice).toFixed(2) : '--') +
      '</span><span class="divider">|</span><span class="sl">止损 ¥' +
      (slPrice ? Number(slPrice).toFixed(2) : '--') + '</span></div>';
  }
  return '';
}

// ===== 指数行情栏 =====
// 韩日开市状态(北京时间): KOSPI 08:00-14:30无午休; 日经 08:00-14:30, 午休10:30-11:30
 function intlMarketStatus(region) {
  const now = new Date();
  const day = now.getDay();
  if (day === 0 || day === 6) return { text: '休市', cls: 'closed' };
  const t = now.getHours() * 60 + now.getMinutes();
  if (region === 'jp' && t >= 630 && t < 690) return { text: '午休', cls: 'closed' };
  if (t >= 480 && t <= 870) return { text: '开市', cls: 'open' };
  return { text: '休市', cls: 'closed' };
}

async function loadIndexStrip() {
  const el = document.getElementById('indexStrip');
  if (!el) return;
  try {
    const d = await fetchJSON('/api/index_quotes');
    const parts = [];
    (d.indices || []).forEach(function(ix) {
      const has = (ix.price != null && ix.change_pct != null);
      let mkt = '';
      if (ix.region === 'kr' || ix.region === 'jp') {
        const st = intlMarketStatus(ix.region);
        mkt = ' <span class="idx-mkt ' + st.cls + '">' + st.text + '</span>';
      }
      let body;
      if (ix.caliber === 'preclose' && ix.price != null) {
        // 昨收口径(仅当server开关INTL_REALTIME=False时出现)
        body = '<span class="idx-caliber">昨收</span>' +
          '<span class="idx-px idx-flat">' + ix.price.toFixed(2) + '</span>';
      } else {
        const cls = !has ? 'idx-flat' : ix.change_pct > 0 ? 'idx-up' : ix.change_pct < 0 ? 'idx-down' : 'idx-flat';
        const px = has ? ix.price.toFixed(2) : '--';
        const chg = has ? ((ix.change_pct >= 0 ? '+' : '') + ix.change_pct.toFixed(2) + '%') : '--';
        body = '<span class="idx-px ' + cls + '">' + px + '</span>' +
          '<span class="idx-chg ' + cls + '">' + chg + '</span>';
        // 合理性守卫: 国际指数|涨跌幅|>8%仅console记录, 显示层完全静默(用户裁决: 韩日与其他指数显示完全一致)
        if (has && ix.region !== 'cn' && Math.abs(ix.change_pct) > 8) {
          console.warn('[index-strip] ' + ix.name + ' 涨跌幅异常波动 ' + ix.change_pct + '%, 建议行情终端交叉确认');
        }
      }
      parts.push('<span class="idx-item"><span class="idx-name">' + ix.name + '</span>' + body + mkt + '</span>');
    });
    // 大A涨跌家数比
    if (d.breadth) {
      parts.push('<span class="idx-breadth"><span class="idx-name">大A涨跌比</span> ' +
        '<span class="idx-up">↑' + d.breadth.up + '</span>' +
        '<span style="color:var(--text3);">/</span>' +
        '<span class="idx-down">↓' + d.breadth.down + '</span>' +
        '<span style="color:var(--text3);font-size:10px;"> 平' + d.breadth.flat + '</span></span>');
    } else {
      parts.push('<span class="idx-breadth idx-name">大A涨跌比 --</span>');
    }
    el.innerHTML = parts.join('');
  } catch (e) {
    el.innerHTML = '<span style="color:var(--text3);">指数行情暂不可用</span>';
  }
}

// 指数栏刷新时段: 工作日07:55-15:05(覆盖韩日早开与A股收盘), 收盘后停更
function isIndexSession() {
  const now = new Date();
  const day = now.getDay();
  if (day === 0 || day === 6) return false;
  const t = now.getHours() * 60 + now.getMinutes();
  return t >= 475 && t <= 905;
}

// ===== Status =====
// 头部本地时钟: 每秒+1走秒("系统活着"直观反馈); 数据侧真实快照时间另见kpiDataTime, 两者口径分离
function tickLocalClock() {
  const el = document.getElementById('serverTime');
  if (!el) return;
  const n = new Date();
  const p = function(x) { return String(x).padStart(2, '0'); };
  el.textContent = n.getFullYear() + '-' + p(n.getMonth() + 1) + '-' + p(n.getDate()) +
    ' ' + p(n.getHours()) + ':' + p(n.getMinutes()) + ':' + p(n.getSeconds());
}

// ===== 当日交易事件滚动栏 (Task#84: /api/live/events, 30s轮询, hover暂停) =====
function escHtml(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function renderEventItem(e) {
  let html = '<span class="evt-item">';
  html += '<span class="evt-time">' + escHtml(e.time) + '</span>';
  html += '<span class="evt-name">' + escHtml(e.name || e.code) + '</span>';
  if (e.price != null) html += '<span class="evt-px">¥' + Number(e.price).toFixed(2) + '</span>';
  if (e.type === 'buy') {
    html += '<span class="evt-act-buy">买入</span>';
  } else if (e.type === 'sell') {
    html += '<span class="evt-act-sell">卖出</span>';
    if (e.pnl_pct != null) {
      const cls = e.pnl_pct >= 0 ? 'evt-pnl-profit' : 'evt-pnl-loss';
      html += '<span class="' + cls + '">' + (e.pnl_pct >= 0 ? '+' : '') + Number(e.pnl_pct).toFixed(2) + '%</span>';
    }
    if (e.note) html += '<span class="evt-note">' + escHtml(e.note) + '</span>';
  } else if (e.type === 'shadow') {
    html += '<span class="evt-note">' + escHtml(e.note || '冲板信号') + '</span>';
    html += '<span class="evt-shadow-badge">测试中</span>';
  }
  if (e.strategy_cn) html += '<span class="evt-strat">[' + escHtml(e.strategy_cn) + ']</span>';
  html += '</span>';
  return html;
}

async function loadLiveEvents() {
  const track = document.getElementById('eventsTrack');
  if (!track) return;
  try {
    const d = await fetchJSON('/api/live/events');
    const events = d.events || [];
    if (!events.length) {
      track.classList.remove('scrolling');
      track.innerHTML = '<span class="evt-empty">今日暂无交易</span>';
      return;
    }
    const items = events.map(renderEventItem).join('');
    // 内容复制两份做无缝循环滚动(translateX -50%回到起点); 时长随条数自适应
    track.style.setProperty('--evt-dur', Math.max(20, events.length * 8) + 's');
    track.innerHTML = items + items;
    track.classList.add('scrolling');
  } catch(e) { console.error('events error', e); }
}

async function loadStatus() {
  try {
    const d = await fetchJSON('/api/status');
    // serverTime改由本地钟每秒接管(tickLocalClock), 此处不再覆写
    document.getElementById('footerStatus').textContent =
      '候选文件: ' + d.total_candidate_files + ' | 决策文件: ' + d.total_decision_files +
      ' | 持仓更新: ' + (d.positions_updated || '--');

    // 展示空窗期信息
    const gapEl = document.getElementById('tradingGapNotice');
    if (d.last_trade_date && d.idle_days > 0) {
      let html = '<span style="color:var(--amber);font-weight:600;">⚠ 最后交易: ' + d.last_trade_date + '</span>';
      html += ' <span style="color:var(--text3);">| 之后 ' + d.idle_days + ' 个交易日未开仓</span><br/>';
      const reasons = d.idle_info || [];
      reasons.forEach(function(item) {
        html += '<span style="color:var(--text3);font-size:11px;margin-right:12px;">· ' + item.date + ': ' + item.reason + '</span>';
      });
      gapEl.innerHTML = html;
      gapEl.style.display = 'block';
    } else if (d.last_trade_date && d.idle_days === 0) {
      gapEl.style.display = 'none';
    }
  } catch(e) { console.error('status error', e); }
}

// ===== Auto refresh =====
// 每5秒检查一次，只在交易时段(9:25-15:00)刷新行情
setInterval(() => {
  if (isTradeSession()) refreshQuotes();
}, 5000);
// 持仓表结构重载(30s): 修复卖出/换仓后槽位行内容不切换的滞后 bug（此前仅init时加载一次,
// refreshQuotes只刷价格单元格不刷行结构，导致如S5卖出国新能源后页面不会换成新持仓）
setInterval(() => {
  if (isTradeSession()) loadPositions();
}, 30000);
// 指数行情栏30s刷新(服务端另30s缓存, 实际上游频率≤每30s一次)
setInterval(() => {
  if (isIndexSession()) loadIndexStrip();
}, 30000);
// 当日交易事件滚动栏30s刷新(Task#84, 不设session门: 盘后也展示当日事件)
setInterval(loadLiveEvents, 30000);
setInterval(refreshHeaderStats, KPI_POLL_MS);  // Task#82: 头部统计随快照动态刷新
setInterval(loadStatus, 60000);
setInterval(updateMarketTag, 10000);
setInterval(tickLocalClock, 1000);  // 头部本地钟走秒

