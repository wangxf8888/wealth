      // 策略条件说明
      if (stratInfo.candidate_condition) {
        html += '<div style="padding:4px 14px 6px;border-bottom:1px solid rgba(26,36,54,0.4);font-size:11px;line-height:1.6;">';
        html += '<div style="color:var(--text3);">📋 候选: ' + stratInfo.candidate_condition + '</div>';
        html += '<div style="color:var(--text3);">🎯 买入: ' + stratInfo.buy_condition + (stratInfo.type === 'A' ? ' <span style="background:rgba(0,200,122,0.15);color:#00c87a;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:600;">直接买</span>' : ' <span style="background:rgba(240,160,48,0.15);color:#f0a030;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:600;">需确认</span>') + '</div>';
        html += '</div>';
      }

      html += '<div class="cand-strategy-body">';

      if (cands.length === 0) {
        html += '<div class="cand-strategy-empty">暂无候选</div>';
      } else {
        // 买入信号排最前
        const sorted = cands.slice().sort(function(a, b) {
          const da = decisionMap[a.code];
          const db = decisionMap[b.code];
          const wa = da && da.status === 'buy' ? 0 : 1;
          const wb = db && db.status === 'buy' ? 0 : 1;
          return wa - wb;
        });
        sorted.forEach(function(c) {
          const dec = decisionMap[c.code];
          const isBought = holdingCodes.has(c.code);
          const boughtTag = isBought ? ' <span class="bought-tag">已买入</span>' : '';
          let conditionHtml = '';
          if (dec && dec.status === 'buy') {
            conditionHtml = '<span style="color:var(--red);font-weight:600;">★买入 @' + dec.buy_price.toFixed(2) + '</span>';
          } else if (dec && dec.status === 'meet') {
            conditionHtml = '<span style="color:var(--amber);">满足 ' + (dec.open_rate_pct >= 0 ? '+' : '') + dec.open_rate_pct.toFixed(2) + '%</span>';
          } else if (hasDecision && decWithOpen) {
            conditionHtml = '<span style="color:var(--text3);">跳过</span>';
          } else if (hasDecision && !decWithOpen) {
            conditionHtml = '<span style="color:var(--text3);">待开盘价</span>';
          } else {
            conditionHtml = '<span style="color:var(--text3);">待决策</span>';
