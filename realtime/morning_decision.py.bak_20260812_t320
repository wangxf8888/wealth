# 昨日锚SQL: 9:25时点stock_kline尚无当日行, 以昨日行锚定W1&W3池
# (窗口/深度与回测口径换算: 截至昨日20行=研究[d-20,d-1]窗口;
#  nprev>=24 = 研究nhist>=25去掉当日行)
_REPAIR_POOL_Q_LIVE = """
WITH h AS (
  SELECT code, date, close, close_rate, amount, isST,
         MIN(low)  OVER w20 AS low20,
         MAX(high) OVER w20 AS high20,
         COUNT(*)  OVER (PARTITION BY code ORDER BY date
                         ROWS BETWEEN 23 PRECEDING AND CURRENT ROW) AS nprev
  FROM stock_kline
  WHERE date <= :prev AND date >= :warmup
  WINDOW w20 AS (PARTITION BY code ORDER BY date
                 ROWS BETWEEN 19 PRECEDING AND CURRENT ROW)
)
SELECT code, close FROM h
WHERE date = :prev AND isST = 0 AND close > 0
  AND close_rate <= :w1_drop AND amount >= :min_amt AND nprev >= :min_prev
  AND high20 > 0 AND close <= low20 + (high20 - low20) * :w3_pos
"""


def query_repair_pool(conn, prev_date: str) -> dict:
    """昨日锚W1&W3池: {code: 昨日close}。9:25可算(只依赖截至昨日的日K)。"""
    warmup = (datetime.strptime(prev_date, '%Y-%m-%d')
              - timedelta(days=120)).strftime('%Y-%m-%d')
    return dict(conn.execute(_REPAIR_POOL_Q_LIVE, {
        'prev': prev_date, 'warmup': warmup,
        'w1_drop': REPAIR_W1_DROP, 'min_amt': REPAIR_MIN_AMT,
        'min_prev': REPAIR_MIN_HIST - 1, 'w3_pos': REPAIR_W3_POS}))


def judge_repair_day(conn, prev_date: str, quote_fn,
                     gate: int = REPAIR_GATE,
                     min_coverage: float = 0.8) -> dict:
    """9:25实盘修复日判定(仅冰点触发日调用, 失败安全降级为不豁免)。

    quote_fn(codes)->{code:{'open','preclose'}}:
      实盘 = fetch_realtime_open_prices(腾讯batch=50+Sina备用)
      测试 = fetch_test_open_prices(conn, codes, test_date)
    浅高开口径: open_rate=(open/preclose-1)*100 ∈ [2,3), preclose优先行情
    交易所口径, 缺失回退昨日库内close; 开盘可买过滤与研究口径逐位一致。
    降级条件(任一→is_repair=False不豁免, degraded留痕):
      SQL异常 / quote_fn异常 / 竞价覆盖率<min_coverage。
    返回留痕dict(写入decision json position_scale.repair_exempt)。
    """
    res = {'pool_size': None, 'quotes_got': None, 'shallow_cnt': None,
           'gate': gate, 'is_repair': False, 'degraded': None,
           'confidence_note': REPAIR_CONFIDENCE_NOTE}
    try:
        pool = query_repair_pool(conn, prev_date)
    except sqlite3.Error as e:
        res['degraded'] = f'W1&W3池SQL异常: {e}'
        return res
    res['pool_size'] = len(pool)
    if len(pool) < gate:
        # 池本身不足gate → 必然非修复日, 无需拉行情(省流量)
        res['quotes_got'] = 0
        res['shallow_cnt'] = 0
        return res
    try:
        quotes = quote_fn(sorted(pool)) or {}
    except Exception as e:
        res['degraded'] = f'竞价行情获取异常: {e}'
        return res
    res['quotes_got'] = len(quotes)
    if len(quotes) < len(pool) * min_coverage:
        res['degraded'] = (f'竞价覆盖率不足: {len(quotes)}/{len(pool)}'
                           f'<{min_coverage:.0%}, 不豁免')
        return res
    cnt = 0
    for code, q in quotes.items():
        open_p = q.get('open') or 0
        preclose = q.get('preclose') or 0
        if preclose <= 0:
            preclose = pool.get(code) or 0     # 行情昨收缺失→库内昨close
        if open_p <= 0 or preclose <= 0:
            continue
        open_rate = (open_p / preclose - 1) * 100
        if not (REPAIR_OPEN_LO <= open_rate < REPAIR_OPEN_HI):
            continue
        if repair_open_buyable(code, open_p, preclose):
            cnt += 1
    res['shallow_cnt'] = cnt
    res['is_repair'] = cnt >= gate
    return res


def compute_final_scale(conn, trade_date: str, quote_fn=None) -> dict:
    """Task#73接线: 冰点overlay × 回撤作战手册叠乘, 单一口径供9:25决策
    与早间计划报告(tools/daily_plan_report)共用, 禁止各自另算第二套口径。

    修复日豁免(2026-07-31批准, RESEARCH_REPAIR_GATE §4): 仅冰点触发日且
    quote_fn可用时判定; 命中→冰点系数豁免恢复1.0(再与回撤侧叠乘)。
    quote_fn缺省(报告侧daily_plan_report)=不判定, 维持冰点口径(B4零改动),
    最终值由decision json留痕。

    回撤侧读 tools/drawdown_guard.get_live_scale()(盘后19:00 strategy_health
    快照落盘的状态); 状态缺失/异常 → 安全降级L0(1.0, 无白名单),
    final=ice, 零影响交易主链。叠乘用drawdown_guard.combine_scale
    (下限0.1; 熔断dd=0时直接0不套floor)。

    返回decision json 'position_scale'字段(全留痕):
      {prev_date, limitup_cnt, scale(=冰点含豁免后, 兼容旧读方),
       ice_scale, repair_exempt(None|判定留痕dict), drawdown_scale,
       drawdown_level, whitelist(None|list), halt, final_scale}
    """
    ice = compute_position_scale(conn, trade_date)
    ice_eff = ice['scale']
    repair_info = None
    if (REPAIR_EXEMPT_ENABLED and quote_fn is not None
            and ice_eff < 1.0 and ice.get('prev_date')):
        repair_info = judge_repair_day(conn, ice['prev_date'], quote_fn)
        if repair_info['is_repair']:
            ice_eff = 1.0
            print(f"  ★ [修复日豁免] 浅高开{repair_info['shallow_cnt']}只"
                  f">=gate{repair_info['gate']} → 冰点减仓豁免, 恢复满仓"
                  f" (低置信度警示已留痕)")
        elif repair_info.get('degraded'):
            print(f"  [修复日豁免] 降级不豁免: {repair_info['degraded']}")
    try:
        from tools import drawdown_guard
        dd_scale, whitelist = drawdown_guard.get_live_scale()
        try:
            _st = json.load(open(drawdown_guard.STATE_FILE))
            dd_level = _st.get('level', 0)
            halt = bool(_st.get('halt', False))
        except (OSError, ValueError):
            dd_level, halt = 0, False
        final = drawdown_guard.combine_scale(ice_eff, dd_scale)
        level_desc = drawdown_guard.LEVEL_DESC.get(dd_level, str(dd_level))
    except Exception as e:                  # 安全降级: 接线异常不阻断决策
        print(f"  [回撤guard] 状态读取异常({e!r}), 安全降级L0满系数")
        dd_scale, whitelist, dd_level, halt = 1.0, None, 0, False
        final, level_desc = ice_eff, 'L0正常(降级)'
    out = dict(ice)
    out.update({'scale': ice_eff, 'ice_scale': ice_eff,
                'repair_exempt': repair_info,
                'drawdown_scale': dd_scale,
                'drawdown_level': dd_level, 'whitelist': whitelist,
                'halt': halt, 'final_scale': final})
    if dd_scale != 1.0 or halt:
        print(f"  [回撤guard] {level_desc}: 回撤系数×{dd_scale}"
              + (f", 仅白名单{whitelist}可开新仓" if whitelist else "")
              + (" — 熔断停止一切新开仓" if halt else ""))
        print(f"  ★ 最终买入系数 = 冰点{ice_eff} × 回撤{dd_scale} → "
              f"{final} (floor 0.1)")
    else:
        print(f"  [回撤guard] {level_desc}, 最终买入系数={final}")
    return out


