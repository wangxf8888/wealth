def _get_max_hold_hours(strategy_name: str) -> int:
    """通过策略名获取max_hold_hours参数。"""
    for cfg in ACTIVE_STRATEGIES:
        if not cfg['enabled']:
            continue
        try:
            mod = importlib.import_module(cfg['module'])
            cls = getattr(mod, cfg['class'])
            instance = cls()
            if instance.name == strategy_name:
                return getattr(instance, 'max_hold_hours', 8)
        except Exception:
            continue
    return 8  # 默认值


def _calc_expire_date(buy_date_str: str, max_hold_hours: int, conn) -> str:
    """计算到期日 = 买入日 + ceil(max_hold_hours/4)个交易日。"""
    days_needed = math.ceil(max_hold_hours / 4)
    # 优先用数据库交易日历
    cursor = conn.execute(
        "SELECT DISTINCT date FROM stock_kline WHERE date > ? ORDER BY date LIMIT ?",
        (buy_date_str, days_needed)
    )
    trading_dates = [r[0] for r in cursor.fetchall()]
    if len(trading_dates) >= days_needed:
        return trading_dates[days_needed - 1]
    # fallback: 简单加自然日（跳过周末）
    buy_date = datetime.strptime(buy_date_str, '%Y-%m-%d')
    current = buy_date
    count = 0
    while count < days_needed:
        current += timedelta(days=1)
        if current.weekday() < 5:
            count += 1
    return current.strftime('%Y-%m-%d')


def generate_pending_buys(trade_date: str, decisions: dict, conn=None,
                          scale: float = 1.0, weak_info: dict = None):
    """生成待确认买入记录(供position_tracker使用)。

    scale(Task#68): 冰点overlay买入系数, 逐笔写入pending记录,
    confirm_buy按此系数分配金额(审计链路: decision json → pending → 持仓)。
    weak_info(Task#205 expam35): {'is_weak','limitup_cnt'} 弱市日判定
    (D-1非ST涨停家数<ICE, 与冰点同源同一次计算)。弱市日买入的S2
    (巨振反转amplitude_reversal)仓 → pending落weak_buy=true+limitup_cnt_d1,
    到期日改早盘AM离场(evaluate_position gap判TP/SL)。旧仓无字段=false。
    """
    pending = []
    buy_date = trade_date
    # 如果没传conn，自行连接
    own_conn = False
    if conn is None:
        conn = sqlite3.connect(DATA_DB)
        own_conn = True

    for slot_id, res in sorted(decisions.items()):
        recs = res.get('recommendations', [])
        if not recs:
            continue
        rec = recs[0]  # 每slot取top1执行

        # 根据策略获取max_hold_hours计算expire_date
        strategy_name = res['strategy']
        max_hold_hours = _get_max_hold_hours(strategy_name)
        sell_at = None
        if rec.get('sell_mode') == 'timed':
            # timed(Task#36): 定时点=买入次日(下一交易日)+sell_time,
            # expire_date=同日(cron旧到期语义兜底也在同一天生效)
            next_d = _calc_expire_date(buy_date, 4, conn)  # ceil(4/4)=1 → 次交易日
            sell_at = {'date': next_d,
                       'time': rec.get('sell_time') or '10:30'}
            expire_date = next_d
        else:
            expire_date = _calc_expire_date(buy_date, max_hold_hours, conn)

        pending_rec = {
            'code': rec['code'],
            'name': rec['name'],
            'strategy': res['strategy'],
            # V-C开启时slot_id=动态资金位编号(P×, allocate_idle_slots分配);
            # 关闭时无vc_assigned_slot字段, 仍为策略通道号(S×, 现行行为)
            'slot_id': res.get('vc_assigned_slot') or slot_id,
            'buy_date': buy_date,
            'buy_price': rec['buy_price'],
            'tp_price': rec.get('tp_price'),
            'sl_price': rec['sl_price'],
            'sell_mode': rec.get('sell_mode', 'fixed'),
            'trailing_pp': rec.get('trailing_pp'),
            'sell_at': sell_at,
            'expire_date': expire_date,
            'position_scale': scale,   # Task#68 冰点overlay系数透传confirm_buy
            # G2确认三参: decision → pending → confirm_buy持仓落盘(A6→A7)
            'confirm_bars': rec.get('confirm_bars', 0),
            'confirm_before': rec.get('confirm_before', ''),
            'confirm_scope': rec.get('confirm_scope', 'trailing'),
        }
        # weak_buy标记(Task#205 expam35): 弱市日买入的S2巨振反转仓打标;
        # 铁律兜底: 任何异常→不打标(保持旧到期语义)+ERROR日志
        try:
            if (weak_info and weak_info.get('is_weak')
                    and res['strategy'] == 'amplitude_reversal'):
                pending_rec['weak_buy'] = True
                pending_rec['limitup_cnt_d1'] = weak_info.get('limitup_cnt')
                print(f"  [weak_buy] {rec['code']} {rec['name']} 弱市日买入"
                      f"(D-1涨停{weak_info.get('limitup_cnt')}家<"
                      f"{POSITION_SCALE_ICE}) → 打标weak_buy, 到期日早盘AM离场")
        except Exception as e:
            print(f"  [ERROR][weak_buy] 打标异常降级不打标(旧到期语义): {e!r}")
        pending.append(pending_rec)

    if own_conn:
        conn.close()

    if pending:
        pending_file = os.path.join(OUTPUT_DIR, 'pending_buys.json')
        tmp_path = pending_file + '.tmp'
        with open(tmp_path, 'w', encoding='utf-8') as f:
            json.dump(pending, f, ensure_ascii=False, indent=2)
        os.replace(tmp_path, pending_file)
        print(f"\n[INFO] 已生成 {len(pending)} 笔待确认买入 → {pending_file}")
        for p in pending:
            if p.get('sell_mode') == 'timed':
                sa = p.get('sell_at') or {}
                sell_desc = (f"定时卖出 {sa.get('date','?')} "
                             f"{sa.get('time','?')}(无盘中TP/SL)")
            elif p.get('sell_mode') == 'trailing':
                sell_desc = (f"移动止盈(回落{p.get('trailing_pp', 2.0)}pp) "
                             f"SL={p['sl_price']:.2f}")
            else:
                tp_str = f"{p['tp_price']:.2f}" if p.get('tp_price') else '无'
                sell_desc = f"TP={tp_str} SL={p['sl_price']:.2f}"
            print(f"  [{p['slot_id']}:{p['strategy']}] {p['code']} {p['name']} "
                  f"@{p['buy_price']:.2f} {sell_desc}")


