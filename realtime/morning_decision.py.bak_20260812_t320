                        help='测试模式:从DB读取历史开盘价')
    parser.add_argument('--confirm', action='store_true', default=False,
                        help='测试模式下仍执行confirm_buy(用于漏跑补录)')
    args = parser.parse_args()

    test_date = args.test_date
    os.makedirs(LOG_DIR, exist_ok=True)
    os.makedirs(OUTPUT_DIR, exist_ok=True)

    conn = sqlite3.connect(DATA_DB)

    # 确定交易日
    if test_date:
        trade_date = test_date
        print(f"[morning_decision] 测试模式, 交易日: {trade_date}")
    else:
        trade_date = datetime.now().strftime('%Y-%m-%d')
        print(f"[morning_decision] 实盘模式, 交易日: {trade_date}")

    # 查找候选股文件
    cand_file = os.path.join(OUTPUT_DIR, f'candidates_{trade_date.replace("-", "")}.json')
    if not os.path.exists(cand_file):
        print(f"[ERROR] 候选股文件不存在: {cand_file}")
        print(f"  请先运行 generate_candidates.py 生成候选股")
        conn.close()
        return 1

    # 加载候选股
    with open(cand_file, 'r', encoding='utf-8') as f:
        candidates_json = json.load(f)

    signal_date = candidates_json.get('signal_date', '?')
    strategies_data = candidates_json.get('strategies', {})

    if not strategies_data:
        print("[ERROR] 候选股文件中无strategies数据(可能是旧版格式)")
        conn.close()
        return 1

    # 统计候选
    total_cands = sum(len(s.get('candidates', [])) for s in strategies_data.values())
    print(f"  信号日: {signal_date} | 总候选: {total_cands}只 | "
          f"策略slots: {len(strategies_data)}个")

    # 收集所有需要开盘价的代码
    all_codes = list(set(
        c['code']
        for s in strategies_data.values()
        for c in s.get('candidates', [])
    ))

    # 获取开盘价+昨收 ({code: {'open':..., 'preclose':...}})
    if test_date:
        print(f"  使用DB中 {trade_date} 的开盘价...")
        quotes = fetch_test_open_prices(conn, all_codes, trade_date)
    else:
        print(f"  获取实时开盘价...")
        quotes = fetch_realtime_open_prices(all_codes)

    print(f"  获取到 {len(quotes)}/{len(all_codes)} 只开盘价")

    # 行情源合理性熔断(Task#38): 候选开盘涨幅集体≈0% → 行情源异常,
    # 拒绝生成决策(宁可人工介入, 不可静默错过滤; DIAG_20260724事故防线)
    anomaly = check_quote_anomaly(quotes, strategies_data)
    if anomaly:
        alert_msg = (
            f"🚨 [morning_decision] 行情源异常熔断 {trade_date}\n"
            f"  {anomaly['checked']}只候选中{anomaly['flat_count']}只"
            f"|open_rate|<{anomaly['flat_tol_pct']}% "
            f"(占比{anomaly['flat_ratio_pct']}%>90%), "
            f"疑似行情源返回昨日/静态数据(参DIAG_20260724)。\n"
            f"  样本: {', '.join(anomaly['sample'][:5])}\n"
            f"  今日已拒绝生成买入决策。人工复核路径: 确认行情源恢复后\n"
            f"  python3 realtime/morning_decision.py "
            f"--test-date {trade_date} --confirm 补录(需当日日K已入库)。")
        print("\n" + "=" * 60)
        print(alert_msg)
        print("=" * 60)
        # 企微通知(未配置时send_text自动降级为日志)
        try:
            from realtime.notify import send_text
            send_text(alert_msg)
        except Exception as e:
            print(f"[WARN] 熔断告警通知发送失败(已有日志兜底): {e}")
        # scheduler_alerts 落一条(与daemon告警同一人工巡检入口)
        try:
            from realtime.position_tracker import SCHEDULER_ALERT_LOG
            _fuse_msg = (f"🚨 morning_decision行情源异常熔断: "
                         f"{anomaly['flat_count']}/{anomaly['checked']}只候选"
                         f"open_rate≈0%, 已拒绝生成决策, 需人工复核补录")
            with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
                f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                        f"{_fuse_msg}\n")
            # [Task#256 G2] P0熔断条目落文件同时实时推企微(失败静默)
            from realtime.notify import push_alert
            push_alert(_fuse_msg)
        except Exception:   # 告警/推送任何异常均不阻断熔断主流程
            pass
        decision = {
            'trade_date': trade_date,
            'signal_date': signal_date,
            'decided_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'status': 'aborted_quote_anomaly',
            'quote_anomaly': anomaly,
            'strategies': {},
        }
        out_file = os.path.join(OUTPUT_DIR, f'decision_{trade_date.replace("-", "")}.json')
        _write_decision_json(out_file, decision)
        print(f"\n[ABORT] 决策已中止(status=aborted_quote_anomaly): {out_file}")
        conn.close()
        return 1

    # 大盘熔断 [Task#68 2026-07-29移除, 用户已批准]: Task#64数据裁决证明
    # "前日上证跌>1%不开新仓"方向性错误(6年成本-41.6pp年化/Calmar 4.20→3.55,
    # 熔断日买入笔均+1.20%反而更肥), 替换为下方冰点减仓overlay。
    # 回滚=取消以下注释并删除compute_position_scale段:
    # market_filtered = check_market_filter(conn, trade_date)
    # if market_filtered:
    #     decision = {
    #         'trade_date': trade_date,
    #         'signal_date': signal_date,
    #         'decided_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
    #         'market_filter': '触发-前日大盘跌>阈值,今日不开新仓',
    #         'strategies': {},
    #     }
    #     out_file = os.path.join(OUTPUT_DIR, f'decision_{trade_date.replace("-", "")}.json')
    #     _write_decision_json(out_file, decision)
    #     print(f"\n[OK] 决策已保存(大盘过滤): {out_file}")
    #     conn.close()
    #     return 0

    # 冰点减仓overlay(Task#68) × 回撤作战手册(Task#73): 单一口径叠乘留痕
    # 修复日豁免(2026-07-31): quote_fn随模式适配(实盘=腾讯/测试=库内当日开盘)
    _quote_fn = ((lambda codes: fetch_test_open_prices(conn, codes, trade_date))
                 if test_date else fetch_realtime_open_prices)
    pos_scale = compute_final_scale(conn, trade_date, quote_fn=_quote_fn)

    # 回撤加仓boost(Task#205): 非冰点日且盘后回撤>=15% → final_scale×1.5;
    # 冰点ice优先boost让位; 状态缺失/异常安全降级不加仓(函数内兜底)
    pos_scale = apply_drawdown_boost(pos_scale)

    # 弱市日判定(Task#205 expam35): 与冰点同源复用同一次limitup_cnt计算;
    # 不可得(降级日)→按非弱市处理(不打标, 保持旧到期语义)
    _cnt = pos_scale.get('limitup_cnt')
    weak_info = {'is_weak': (_cnt is not None and _cnt < POSITION_SCALE_ICE),
                 'limitup_cnt': _cnt}
    if weak_info['is_weak']:
        print(f"  [weak_buy] 今日为弱市日(D-1涨停{_cnt}家<"
              f"{POSITION_SCALE_ICE}): 今日买入的S2巨振反转仓将打标weak_buy")
    pos_scale['weak_day'] = weak_info['is_weak']   # decision json留痕

    # L3熔断(Task#73): 回撤≥30%停止一切新开仓, 决策json显著标注;
    # 解除需人工ack: python3 tools/drawdown_guard.py ack
    if pos_scale['halt']:
        banner = (f"🚨 [回撤熔断L3] {trade_date} 停止一切新开仓 "
                  f"(回撤作战手册, 需人工ack解除: "
                  f"python3 tools/drawdown_guard.py ack)")
        print("\n" + "=" * 60 + f"\n{banner}\n" + "=" * 60)
        decision = {
            'trade_date': trade_date,
            'signal_date': signal_date,
            'decided_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'framework_version': '2.0',
            'status': 'halted_drawdown_L3',
            'note': '回撤≥30%熔断中, 停止一切新开仓; 解除: '
                    'python3 tools/drawdown_guard.py ack',
            'position_scale': pos_scale,
            'strategies': {},
        }
        out_file = os.path.join(
            OUTPUT_DIR, f'decision_{trade_date.replace("-", "")}.json')
        _write_decision_json(out_file, decision)
        print(f"[HALT] 决策已中止(status=halted_drawdown_L3): {out_file}")
        try:
            from realtime.position_tracker import SCHEDULER_ALERT_LOG
            with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
                f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                        f"{banner}\n")
        except OSError:
            pass
        conn.close()
        return 0

    # 执行决策
    decisions = morning_evaluate(trade_date, quotes, strategies_data)

    # L2白名单拦截(Task#73): whitelist_only时仅白名单策略(创科晚封/大阳低吸)
    # 可开新仓, 其余槽位跳过并留痕(skipped_by_drawdown_whitelist)
    if pos_scale.get('whitelist') is not None:
        _wl = set(pos_scale['whitelist'])
        for _sid, _res in sorted(decisions.items()):
            if _res.get('strategy') not in _wl and _res.get('recommendations'):
                _res['skipped_by_drawdown_whitelist'] = \
                    _res['recommendations']
                _res['recommendations'] = []
                print(f"  🛑 [回撤L2白名单] {_sid} "
                      f"{strategy_display_name(_res['strategy'])}"
                      f"({_res['strategy']}) 非白名单, 今日跳过开仓")

    # V-C匿名动态槽位分配(用户裁决2026-07-31): 空闲槽数/现金预算内分配
    # 资金位P×, 超出部分skipped_no_idle_slot留痕; 开关关闭时零行为变化
    vc_allocation = None
    if VC_DYNAMIC_SLOTS:
        vc_allocation = allocate_idle_slots(decisions,
                                            scale=pos_scale['final_scale'])

    # 输出
    print_decision(trade_date, signal_date, decisions,
                   scale=pos_scale['final_scale'])

    # 保存决策JSON
    decision_output = {
        'trade_date': trade_date,
        'signal_date': signal_date,
        'decided_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
        'framework_version': '2.0',
        'position_scale': pos_scale,   # Task#68冰点×Task#73回撤 全留痕
        'vc_allocation': vc_allocation,  # V-C槽位分配审计(关闭时null)
        'strategies': decisions,
    }
    out_file = os.path.join(OUTPUT_DIR, f'decision_{trade_date.replace("-", "")}.json')
    _write_decision_json(out_file, decision_output)
    print(f"\n[OK] 决策结果已保存: {out_file}")

    # 生成pending_buy
    generate_pending_buys(trade_date, decisions, conn,
                          scale=pos_scale['final_scale'],
                          weak_info=weak_info)

    if test_date and not args.confirm:
        # 测试模式: 不确认买入/不通知，避免污染实盘持仓(补录请加--confirm)
        print("[INFO] 测试模式：跳过confirm_buy与通知(补录用--confirm)")
        conn.close()
        return 0

    # 生成后直接确认买入，无需等待position_tracker定时执行（消除35分钟延迟）
    from realtime.position_tracker import confirm_buy
    print("[INFO] 直接执行confirm_buy，立即更新持仓...")
    confirm_buy()
    print("[INFO] 持仓已更新")

    # 发送企业微信通知
    try:
        from realtime.notify import notify_buy, notify_morning_summary
        from datetime import datetime as _dt
        now_time = _dt.now().strftime('%H:%M:%S')
        today_date = _dt.now().strftime('%Y-%m-%d')
        for slot_id, info in decisions.items():
            for r in info.get('recommendations', []):
                # V-C开启时通知展示动态资金位编号(与pending/持仓一致)
                r['slot_id'] = info.get('vc_assigned_slot') or slot_id
                r['strategy'] = info.get('strategy', '')
                # Task#205通知增强: boost加仓/弱市仓标注(异常不影响发送)
                _note = ''
                try:
                    _tags = []
                    if pos_scale.get('boost', {}).get('active'):
                        _tags.append('回撤加仓1.5x')
                    if (weak_info.get('is_weak')
                            and info.get('strategy') == 'amplitude_reversal'):
                        _tags.append('弱市仓·到期早盘离场')
                    _note = '｜'.join(_tags)
                except Exception as e:
                    print(f"[ERROR][notify标注] 生成异常降级无标注: {e!r}")
                notify_buy(
                    date_str=today_date,
                    time_str=now_time,
                    stock_name=r.get('name', ''),
                    stock_code=r.get('code', ''),
                    price=r.get('buy_price', 0),
                    stop_profit_price=r.get('tp_price'),
                    stop_loss_price=r.get('sl_price'),
                    note=_note,
                )
        notify_morning_summary(decisions)
    except Exception as e:
        print(f"[morning_decision] 通知发送失败(非致命): {e}")

    conn.close()
    return 0


if __name__ == '__main__':
    sys.exit(main())
