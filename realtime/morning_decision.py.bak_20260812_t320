def check_quote_anomaly(quotes: dict, candidates_data: dict,
                        flat_tol_pct: float = 0.3,
                        min_candidates: int = 5,
                        flat_ratio_threshold: float = 0.90):
    """9:25行情源合理性校验(Task#38防御熔断)。

    背景(DIAG_20260724): 备用源返回昨日K线 → 全部候选open_rate≈0% →
    静默误过滤21只。此类故障有明确统计指纹: 正常交易日候选(隔夜情绪股)
    开盘涨幅几乎不可能集体≈0。

    规则: 有行情的候选≥{min_candidates}只 且 |open_rate|<{flat_tol_pct}%
    的占比>{flat_ratio_threshold:.0%} → 判定行情源异常。
    候选<{min_candidates}只不启用(样本太小, 避免误杀真实集体平开)。

    Returns: None=正常; dict=异常统计(供告警与decision json记录)。
    """
    signal_closes = {}
    for s in candidates_data.values():
        for c in s.get('candidates', []):
            if c.get('signal_close'):
                signal_closes.setdefault(c['code'], c['signal_close'])

    rates = []
    for code, sclose in signal_closes.items():
        q = quotes.get(code)
        if not q or sclose <= 0:
            continue
        rates.append((code, (q['open'] / sclose - 1) * 100))

    if len(rates) < min_candidates:
        return None

    flat = [(c, r) for c, r in rates if abs(r) < flat_tol_pct]
    ratio = len(flat) / len(rates)
    if ratio > flat_ratio_threshold:
        return {
            'checked': len(rates),
            'flat_count': len(flat),
            'flat_ratio_pct': round(ratio * 100, 1),
            'flat_tol_pct': flat_tol_pct,
            'sample': [f"{c}:{r:+.2f}%" for c, r in rates[:10]],
        }
    return None


def morning_evaluate(trade_date: str, quotes: dict, candidates_data: dict) -> dict:
    """对所有策略slots执行买入决策。

    Args:
