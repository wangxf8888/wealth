def load_user_excluded(trade_date: str) -> set:
    """读取当日用户排除名单, 结构{"YYYY-MM-DD": ["sh.688549", ...]}。

    任何异常(文件缺失/JSON损坏/结构不符)一律降级为空集合并留ERROR日志,
    保证决策主链不因排除名单文件问题中断。
    """
    try:
        if not os.path.exists(USER_EXCLUDED_FILE):
            return set()
        with open(USER_EXCLUDED_FILE, encoding='utf-8') as f:
            data = json.load(f)
        codes = data.get(trade_date) or []
        excluded = {str(c).strip() for c in codes if c}
        if excluded:
            print(f"[用户排除] {trade_date} 排除名单生效: {sorted(excluded)}")
        return excluded
    except Exception as e:
        print(f"[ERROR][用户排除] 读取{USER_EXCLUDED_FILE}异常({e!r}), "
              f"降级为空名单继续")
        return set()


