                    print(f"  [逐只] {slot_id} {code} {cname}"
                          f"|拒: [财报期] 预约披露{_eb_hit}落在持有窗内, "
                          f"不参与买入避免碰雷(保留展示)")
                    continue
            if code not in quotes:
                print(f"  [逐只] {slot_id} {code} {cname}|open_rate=NA"
                      f"|拒: 未获取到开盘价")
                continue
            with_open_price += 1

            q = quotes[code]
            open_p = q['open']
            quote_preclose = q.get('preclose', 0)
            signal_close = c.get('signal_close', 0)
            preclose = c.get('signal_close', open_p)  # trade_date preclose ≈ signal_date close
            open_rate = (open_p / preclose - 1) * 100 if preclose > 0 else 0

            if code not in filtered_codes:
                print(f"  [逐只] {slot_id} {code} {cname}"
                      f"|open_rate={open_rate:+.2f}%"
                      f"|拒: live复筛未通过(开盘窗口/策略过滤)")
                continue

            # 入场守卫(Task#45统一): 除权除息拦截+涨停拦截走
            # execution_core.evaluate_open_entry —— 与回测引擎买入循环
            # 同一份入场评估函数(判定顺序/数学口径与历史实盘完全一致:
            # 除权比对=行情昨收vs信号日close, 涨停基准=preclose即信号日close)
            entry_dec, entry_reject = evaluate_open_entry(
                code=code, strategy=strategy.name, slot_id=slot_id,
                date=trade_date, open_price=open_p,
                exchange_preclose=quote_preclose, prev_close=signal_close,
                signal_ref_close=signal_close,
                is_st=trading_rules.is_st_name(c.get('name', '')),
                limit_basis=preclose)
            if entry_reject == 'ex_dividend':
                print(f"  [逐只] {slot_id} {code} {cname}"
                      f"|open_rate={open_rate:+.2f}%"
                      f"|拒: 除权除息日,开盘价语义失真"
                      f"(行情昨收{quote_preclose}≠信号日close{signal_close})")
                continue
            if entry_reject == 'limit_up_open':
                print(f"  [逐只] {slot_id} {code} {cname}"
                      f"|open_rate={open_rate:+.2f}%"
                      f"|拒: 开盘{open_p:.2f}已涨停,买单排队买不到")
                continue

            print(f"  [逐只] {slot_id} {code} {cname}"
                  f"|open_rate={open_rate:+.2f}%|命中")

            sl_price = (round(open_p * (1 + sell_params['sl_pct']), 2)
                        if sell_params['sl_pct'] is not None else None)
            tp_price = (round(open_p * (1 + sell_params['tp_pct']), 2)
                        if sell_params['tp_pct'] is not None else None)

            meet_condition.append({
                'code': code,
                'name': c.get('name', ''),
                'open': round(open_p, 2),
                'signal_close': signal_close,
                'open_rate_pct': round(open_rate, 2),
                'turn': c.get('turn', 0),
                'buy_price': round(open_p, 2),
                'tp_price': tp_price,
                'sl_price': sl_price,
                'sell_mode': sell_params['sell_mode'],
                'trailing_pp': sell_params['trailing_pp'],
                'sell_time': sell_params.get('sell_time'),  # timed用
                # G2确认三参透传(仅trailing+声明策略非零; 其余.get缺省全关)
                'confirm_bars': sell_params.get('confirm_bars', 0),
                'confirm_before': sell_params.get('confirm_before', ''),
                'confirm_scope': sell_params.get('confirm_scope', 'trailing'),
            })

        # 排序取top (保持原策略排序 - filtered_codes已排好序)
        code_rank = {c: i for i, c in enumerate(filtered_codes)}
        meet_condition.sort(key=lambda x: code_rank.get(x['code'], 9999))
        recommendations = meet_condition[:MAX_SLOT_PER_STRATEGY]

        decisions[slot_id] = {
            'strategy': strategy_name,
            'total_candidates': len(candidates),
            'with_open_price': with_open_price,
            'meet_condition': meet_condition,
            'recommendations': recommendations,
        }

        # [Task#285] 策略冻结分支(用户批准A案2026-08-11, t283 DECISION_PACK
        # §2.1): 冻结策略的recommendations转入frozen_recommendations并清空
        # —— allocate_idle_slots只处理有recommendations的通道, 清空后S3自然
        # 退出槽位竞争, 空槽由V-C机制自动分给其余策略(与A案回测语义一致,
        # 零改allocate_idle_slots)。铁律: 任何异常降级为不冻结, 不炸主链。
        try:
            if strategy_name in STRATEGY_FROZEN:
                res = decisions[slot_id]
                # 字段变更先行(日志异常不得留下"frozen但未清recommendations"态)
                res['frozen'] = True
                res['frozen_recommendations'] = recommendations
                res['recommendations'] = []
                for _fr in recommendations:
                    print(f"  [S3冻结] {_fr['code']} {_fr.get('name', '')} "
                          f"满足买入条件但策略已冻结待替换, 转假想跟踪")
                print(f"  [S3冻结] {strategy_name} 候选{len(candidates)}只 "
                      f"仅假想跟踪不买入"
                      f"(满足{len(meet_condition)}只/假想{len(recommendations)}只, "
                      f"槽位交V-C动态竞争)")
        except Exception as e:
            print(f"  [ERROR][S3冻结] 冻结分支异常降级为不冻结: {e!r}")

    data_feed.close()
    return decisions


