def allocate_idle_slots(decisions: dict, scale: float = 1.0,
                        pos_data: dict = None) -> dict:
    """V-C槽位分配: 策略→槽位固定映射改为动态分配。

    用户裁决三原则:
    ①5槽与策略解绑: 槽=纯资金位(P1..P5), 空槽不标策略;
    ②谁有信号谁占空闲槽(复用买入=占真实空闲槽, 槽上标策略名);
    ③无空闲槽时杜绝先买后卖(复用信号当日放弃, skipped_no_idle_slot留痕)。

    口径:
    - 空闲槽数 = 5 - 当前holding数(任何待卖持仓都占槽, S5复用场景自动
      视同"无自己槽", 须有其他空闲槽才买) —— 与回测引擎
      backtest/portfolio.py 的 _empty_slot_id()/has_empty_slot() 同语义;
    - 优先级: 正当新信号(策略无在持仓)优先, 复用信号(策略自身仍有
      待卖持仓)排后; 组内按策略通道名字序, 确定性可重放;
    - 现金预算: 逐笔预留 total_nav/5×scale(不计当日未来回款),
      预留超现金 → skipped_insufficient_cash留痕+告警(正常不应触发,
      触发=账本异常的tripwire); confirm_buy处另有同语义硬断言兑底。

    直接原地修改decisions(同L2白名单拦截模式): 获配通道写
    res['vc_assigned_slot']='P×'; 被跳过通道recommendations清空并转入
    skipped_*字段。返回分配审计块(写入decision json 'vc_allocation')。

    pos_data: 测试注入用(默认load_positions读生产持仓)。
    """
    if pos_data is None:
        pos_data = load_positions()
    account = pos_data.get('account', {})
    cash = account.get('cash', 0)
    holdings = [p for p in pos_data.get('positions', [])
                if p.get('status') == 'holding']
    n_fund_slots = 5
    idle_count = n_fund_slots - len(holdings)

    # 空闲资金位编号: 遗留Sk标签持仓视同占用Pk(平滑迁移, 卖出即释放),
    # 新买入一律用P编号
    used_nums = set()
    for p in holdings:
        m = re.match(r'^[SP](\d+)$', str(p.get('slot_id') or ''))
        if m:
            used_nums.add(int(m.group(1)))
    free_ids = [f'P{n}' for n in range(1, n_fund_slots + 1)
                if n not in used_nums]
    held_strats = set(p.get('strategy') for p in holdings)

    # 每仓目标金额(引擎口径 total_nav/5×scale, 无min(cash)钳制)
    holding_value = sum(p.get('buy_amount') or 0 for p in holdings)
    per_slot = (cash + holding_value) / n_fund_slots * scale

    channels = sorted(k for k in decisions
                      if decisions[k].get('recommendations'))
    order = ([c for c in channels
              if decisions[c].get('strategy') not in held_strats]
             + [c for c in channels
                if decisions[c].get('strategy') in held_strats])

    allocation = {
        'mode': 'vc_dynamic',
        'idle_slots': idle_count,
        'holdings': len(holdings),
        'cash': round(cash, 2),
        'per_slot_target': round(per_slot, 2),
        'assigned': {},
        'skipped': {},
    }
    print(f"\n  [V-C槽位分配] 持仓{len(holdings)}笔 | 空闲槽{idle_count}个"
          f"({','.join(free_ids) or '无'}) | 现金¥{cash:,.0f} | "
          f"每仓目标¥{per_slot:,.0f}")

    reserved = 0.0
    n_assigned = 0
    for ch in order:
        res = decisions[ch]
        strat = res.get('strategy', '?')
        rec0 = res['recommendations'][0]
        is_reuse = strat in held_strats
        tag = '复用' if is_reuse else '新信号'
        if n_assigned >= idle_count or not free_ids:
            # 用户裁决③: 无空闲槽=当日放弃, 杜绝先买后卖
            res['skipped_no_idle_slot'] = res['recommendations']
            res['recommendations'] = []
            allocation['skipped'][ch] = 'no_idle_slot'
            print(f"  🛑 [V-C] {ch} {strategy_display_name(strat)}({tag}) "
                  f"{rec0['code']} {rec0['name']} — 无空闲槽, 当日放弃"
                  f"(skipped_no_idle_slot)")
            continue
        if reserved + per_slot > cash + 0.01:
            # tripwire: 有空闲槽但备付现金不够 = 账本/槽位语义异常
            res['skipped_insufficient_cash'] = res['recommendations']
            res['recommendations'] = []
            allocation['skipped'][ch] = 'insufficient_cash'
            msg = (f"[V-C] {ch} {strategy_display_name(strat)} 有空闲槽但现金"
                   f"不足(已预留¥{reserved:,.0f}+每仓¥{per_slot:,.0f}"
                   f">现金¥{cash:,.0f}), 拒单留痕")
            print(f"  🚨 {msg}")
            try:
                from realtime.position_tracker import SCHEDULER_ALERT_LOG
                with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
                    f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                            f"🚨 {msg}(空闲槽应有备付现金, 需人工对账)\n")
            except OSError:
                pass
            continue
        sid = free_ids.pop(0)
        res['vc_assigned_slot'] = sid
        allocation['assigned'][ch] = {
            'fund_slot': sid,
            'strategy': strat,
            'reuse': is_reuse,
            'code': rec0['code'],
        }
        reserved += per_slot
        n_assigned += 1
        print(f"  ✅ [V-C] {ch} {strategy_display_name(strat)}({tag}) "
              f"{rec0['code']} {rec0['name']} → 资金位{sid}")
    return allocation


