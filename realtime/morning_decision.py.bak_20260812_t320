def get_sell_params(strategy) -> dict:
    """从策略类显式读取卖出参数，保证实盘执行与回测同一套规则。

    - timed模式(B2-A, exit_mode='d2h1_close'): 买入次日H1收盘(10:30)定时了结,
      无盘中TP/SL(策略声明的极宽TP/SL仅为框架读取要求, 不落地) —— Task#36
    - trailing模式(S4): trailing_stop_pp + stop_loss_pp, 无固定TP
    - fixed模式(S1/S2/S3): take_profit_pct + stop_loss_pct。FB-A v2的
      exit_mode='tpsl_d6'(TP/SL挂单监控D2..D6+D6收盘兜底)即fixed+expire_date
      语义, 直接放行fixed分支 —— Task#68
    读取不到明确参数/无法识别的exit_mode时抛异常，绝不静默使用默认值(历史事故根源)。
    """
    exit_mode = getattr(strategy, 'exit_mode', None)
    if exit_mode not in (None, 'hold1_close', 'tpsl_d6'):
        if exit_mode == 'd2h1_close':
            return {
                'sell_mode': 'timed',
                'sell_time': '10:30',   # D2 H1收盘定时点, 与回测d2h1_close一致
                'trailing_pp': None,
                'sl_pct': None,
                'tp_pct': None,
            }
        raise ValueError(
            f"策略 {strategy.name} exit_mode={exit_mode!r} 尚无实盘执行支持"
            f"(目前仅d2h1_close→timed), fail-fast拒单")
    if (hasattr(strategy, 'trailing_stop_pp')
            and getattr(strategy, 'sell_mode', 'trailing') == 'trailing'):
        return {
            'sell_mode': 'trailing',
            'trailing_pp': float(strategy.trailing_stop_pp),
            'sl_pct': -float(strategy.stop_loss_pp) / 100.0,
            'tp_pct': None,
            # 2026-07-31批准(APPROVAL_G2_MINUTE): G2确认三参随卖出参数落盘
            # (缺省全关零侵入; 现仅大阳低吸声明confirm_bars=2)
            'confirm_bars': int(getattr(strategy, 'confirm_bars', 0) or 0),
            'confirm_before': getattr(strategy, 'confirm_before', '') or '',
            'confirm_scope': (getattr(strategy, 'confirm_scope', 'trailing')
                              or 'trailing'),
        }
    if hasattr(strategy, 'take_profit_pct') and hasattr(strategy, 'stop_loss_pct'):
        return {
            'sell_mode': 'fixed',
            'trailing_pp': None,
            'sl_pct': float(strategy.stop_loss_pct),
            'tp_pct': float(strategy.take_profit_pct),
        }
    raise ValueError(
        f"策略 {strategy.name} 未声明卖出参数"
        f"(trailing_stop_pp/stop_loss_pp 或 take_profit_pct/stop_loss_pct)")


