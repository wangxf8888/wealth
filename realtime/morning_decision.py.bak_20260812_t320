def compute_position_scale(conn, trade_date: str) -> dict:
    """冰点减仓overlay: 昨日非ST涨停家数<ICE → 当日新开仓买入金额×W。

    口径与回测 backtest/position_scale.PositionScaler 完全一致:
    D-1 = stock_kline中严格早于trade_date的最后一个交易日, isST=0过滤,
    trading_rules.is_at_limit_up(code, close, preclose) 逐行计数。

    fail-safe: 昨日日K缺失/陈旧(>10自然日) → 系数1.0满仓 +
    scheduler_alerts告警(宁少减仓不拒单, PLAN_TASK44_POSITION_SCALE_LIVE)。
    返回 {'prev_date','limitup_cnt','scale'} 供决策json审计留痕。
    """
    if not POSITION_SCALE_ENABLED:
        return {'prev_date': None, 'limitup_cnt': None, 'scale': 1.0}
    prev_date, cnt = None, None
    try:
        row = conn.execute(
            "SELECT MAX(date) FROM stock_kline WHERE date < ?",
            (trade_date,)).fetchone()
        prev_date = row[0] if row else None
        if prev_date:
            days_gap = (datetime.strptime(trade_date, '%Y-%m-%d')
                        - datetime.strptime(prev_date, '%Y-%m-%d')).days
            if days_gap > 10:
                print(f"  [冰点overlay] 日K陈旧(最新{prev_date}, 距今"
                      f"{days_gap}天), 降级满仓")
                prev_date = None
        if prev_date:
            cnt = 0
            for code, close, preclose in conn.execute(
                    "SELECT code, close, preclose FROM stock_kline "
                    "WHERE date=? AND isST=0", (prev_date,)):
                if trading_rules.is_at_limit_up(code, close, preclose):
                    cnt += 1
    except (sqlite3.Error, ValueError) as e:
        print(f"  [冰点overlay] 计算异常({e}), 降级满仓")
        prev_date, cnt = None, None

    if cnt is None:
        # fail-safe: 涨停家数不可得 → 满仓 + 告警人工巡检
        try:
            from realtime.position_tracker import SCHEDULER_ALERT_LOG
            with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
                f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                        f"⚠️ 冰点overlay降级: {trade_date} 昨日涨停家数"
                        f"不可得(日K缺失/陈旧), 按系数1.0满仓\n")
        except OSError:
            pass
        return {'prev_date': prev_date, 'limitup_cnt': None, 'scale': 1.0}

    trig = cnt < POSITION_SCALE_ICE
    scale = POSITION_SCALE_W if trig else 1.0
    print(f"  [冰点overlay] 昨日({prev_date})非ST涨停家数={cnt} "
          f"{'<' if trig else '>='}{POSITION_SCALE_ICE} → 当日买入系数={scale}")
    if trig:
        print(f"  ★ 冰点减仓: 今日新开仓金额×{POSITION_SCALE_W}")
    return {'prev_date': prev_date, 'limitup_cnt': cnt, 'scale': scale}


