def code_to_sina(code: str) -> str:
    """sh.600000 → sh600000"""
    return code.replace('.', '')


def sina_to_code(sina_code: str) -> str:
    """sh600000 → sh.600000"""
    return sina_code[:2] + '.' + sina_code[2:]


def _fetch_from_tencent(codes: list) -> dict:
    """通过腾讯实时行情接口获取开盘价+昨收。

    返回 {code: {'open': float, 'preclose': float}}。
    parts[5]=今开, parts[4]=昨收(交易所口径, 除权除息日为除权参考价,
    与信号日库内close对比即可识别除权, Task#4实盘侧拦截用)。
    """
    results = {}
    tencent_codes = [code_to_sina(c) for c in codes]
    batch_size = 50

    for i in range(0, len(tencent_codes), batch_size):
        batch = tencent_codes[i:i + batch_size]
        url = f"http://qt.gtimg.cn/q={','.join(batch)}"
        try:
            req = urllib.request.Request(url)
            req.add_header('User-Agent',
                           'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')
            resp = urllib.request.urlopen(req, timeout=10)
            content = resp.read().decode('gbk')
            for line in content.strip().split('\n'):
                line = line.strip()
                if not line:
                    continue
                m = re.match(r'v_(\w+)="(.*)"', line)
                if not m:
                    continue
                tencent_sym = m.group(1)
                data_str = m.group(2)
                if not data_str:
                    continue
                parts = data_str.split('~')
                if len(parts) < 6:
                    continue
                code = sina_to_code(tencent_sym)
                try:
                    open_price = float(parts[5]) if parts[5] else 0
                except (ValueError, IndexError):
                    open_price = 0
                try:
                    preclose = float(parts[4]) if parts[4] else 0
                except (ValueError, IndexError):
                    preclose = 0
                if open_price > 0:
                    results[code] = {'open': open_price, 'preclose': preclose}
        except Exception as e:
            print(f"  [WARN] 腾讯接口请求失败: {e}")
    return results


def _fetch_from_sina(codes: list) -> dict:
    """通过Sina实时行情快照接口获取今开+昨收(备用, Task#38重写)。

    背景(DIAG_20260724): 旧实现用K线接口scale=60&datalen=1, 语义是"最后
    一根已完成的60分K"——9:25当日首根bar尚未形成, 返回的是昨日hour4 bar,
    open≈昨收 → open_rate≈0% → 候选被全量误过滤(周四漏买2只)。

    新实现(2026-07-25实测定型):
    - hq.sinajs.cn 403、quotes.sina.cn点查服务均已下线, 唯一可用的是
      vip.stock.finance.sina.com.cn 的 Market_Center.getHQNodeData
      板块分页快照(单页硬上限100条, sort=symbol全局升序, sh_a含688)。
    - 字段语义(周五静态数据与stock_kline逐位对照验证): open=今开,
      settlement=昨收, trade=现价, ticktime=行情时刻。
    - 无法按symbol点查 → 按node(sh_a/sz_a/bj_a)分页二分定位目标代码,
      页结果进程内缓存, 20只候选实测约10~15次请求/5秒内。

    返回 {code: {'open': float, 'preclose': float}}, 与腾讯源同构。
    """
    results = {}
    import json as _json
    base_url = ("https://vip.stock.finance.sina.com.cn/quotes_service/api/"
                "json_v2.php/Market_Center.")

    def _get_json(url):
        req = urllib.request.Request(url)
        req.add_header('Referer', 'https://finance.sina.com.cn')
        req.add_header('User-Agent',
                       'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')
        resp = urllib.request.urlopen(req, timeout=8)
        return _json.loads(resp.read().decode('utf-8'))

    # 按交易所node分组: sh.688618 → node=sh_a 内查 sh688618
    node_map = {'sh': 'sh_a', 'sz': 'sz_a', 'bj': 'bj_a'}
    by_node = {}
    for code in codes:
        node = node_map.get(code[:2])
        if node:
            by_node.setdefault(node, []).append(code_to_sina(code))

    page_cache = {}  # {(node, page): rows}

    def _fetch_page(node, page):
        key = (node, page)
        if key not in page_cache:
            page_cache[key] = _get_json(
                f"{base_url}getHQNodeData?page={page}&num=100"
                f"&sort=symbol&asc=1&node={node}")
        return page_cache[key]

    for node, syms in by_node.items():
        # 页数上界: getHQNodeStockCount, 失败则保守估60页(6000只)
        try:
            cnt = int(str(_get_json(
                f"{base_url}getHQNodeStockCount?node={node}")).strip('"'))
            n_pages = max(1, (cnt + 99) // 100)
        except Exception:
            n_pages = 60

        for sym in sorted(syms):
            try:
                lo, hi, row = 1, n_pages, None
                while lo <= hi:
                    mid = (lo + hi) // 2
                    rows = _fetch_page(node, mid)
                    if not rows:
                        hi = mid - 1
                        continue
                    if sym < rows[0]['symbol']:
                        hi = mid - 1
                    elif sym > rows[-1]['symbol']:
                        lo = mid + 1
                    else:
                        row = next((r for r in rows if r['symbol'] == sym),
                                   None)
                        break
                if row:
                    open_price = float(row.get('open', 0) or 0)
                    preclose = float(row.get('settlement', 0) or 0)
                    if open_price > 0:
                        results[sina_to_code(sym)] = {
                            'open': open_price, 'preclose': preclose}
            except Exception:
                pass  # 逐只失败不打印，最后汇总

    if not results:
        print(f"  [WARN] Sina快照接口全部失败")
    return results


def fetch_realtime_open_prices(codes: list, max_retries: int = 5,
                               retry_interval: int = 10) -> dict:
    """获取实时开盘价+昨收 - 增量重试确保尽可能全部获取。

    返回 {code: {'open': float, 'preclose': float}} (Task#38起两源同构;
    preclose为交易所口径昨收, 供除权除息拦截)。

    逻辑:
    1. 每轮先用腾讯接口获取remaining中未拿到的
    2. 腾讯拿不到的用Sina备用接口继续获取
    3. 还有剩余则等待retry_interval秒后重试(竞价数据可能延迟就绪)
    4. 最多重试max_retries轮，总耗时不超过 max_retries * retry_interval 秒

    9:25触发 → 最多9:25+50s≈9:26完成，远在9:30正式开盘前。
    """
    import time
    if not codes:
        return {}

    results = {}
    remaining = list(codes)

    for attempt in range(1, max_retries + 1):
        if not remaining:
            break

        # --- 腾讯接口 ---
        print(f"  [第{attempt}/{max_retries}轮] 腾讯接口获取 {len(remaining)} 只...")
        tencent_got = _fetch_from_tencent(remaining)
        if tencent_got:
            results.update(tencent_got)
            remaining = [c for c in remaining if c not in results]
            print(f"    腾讯本轮获取 {len(tencent_got)} 只，累计 {len(results)}/{len(codes)}")

        if not remaining:
            break

        # --- Sina备用接口 ---
        print(f"    Sina备用接口获取剩余 {len(remaining)} 只...")
        sina_got = _fetch_from_sina(remaining)
        if sina_got:
            results.update(sina_got)
            remaining = [c for c in remaining if c not in results]
            print(f"    Sina本轮获取 {len(sina_got)} 只，累计 {len(results)}/{len(codes)}")

        if not remaining:
            break

        # --- 还有剩余，等待后重试 ---
        if attempt < max_retries:
            print(f"    还有 {len(remaining)} 只未获取到，{retry_interval}秒后重试... "
                  f"(未获取: {remaining[:5]}{'...' if len(remaining) > 5 else ''})")
            time.sleep(retry_interval)

    # 最终汇总
    if remaining:
        print(f"  [WARN] {max_retries}轮后仍有 {len(remaining)} 只未获取到开盘价: {remaining}")
    else:
        print(f"  [OK] 全部 {len(codes)} 只开盘价获取完成")

    return results


def fetch_test_open_prices(conn, codes: list, test_date: str) -> dict:
    """从数据库获取指定日期的开盘价+昨收(测试模式)。

    返回 {code: {'open': float, 'preclose': float}}, 与实时源同构。
    preclose取stock_kline当日行(BaoStock交易所口径, 除权日=除权参考价),
    与实盘行情接口昨收语义一致, 除权拦截在测试模式下同样可复现。
    """
    if not codes:
        return {}
    results = {}
    # 分块查询: 修复日豁免的昨日弱势池可达2600+只, 一次IN会撞SQLite
    # 999变量上限(SQLITE_MAX_VARIABLE_NUMBER) → "too many SQL variables"
    for i in range(0, len(codes), 500):
        chunk = codes[i:i + 500]
        placeholders = ','.join(['?' for _ in chunk])
        cur = conn.execute(f"""
            SELECT code, open, preclose FROM stock_kline
            WHERE date = ? AND code IN ({placeholders})
        """, [test_date] + chunk)
        for row in cur.fetchall():
            code, open_p, preclose = row
            if open_p and open_p > 0:
                results[code] = {'open': open_p, 'preclose': preclose or 0}
    return results


