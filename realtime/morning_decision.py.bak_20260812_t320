def apply_drawdown_boost(pos_scale: dict) -> dict:
    """回撤加仓boost: 读盘后落盘的 data/drawdown_state.json 状态机,
    满足全部条件 → final_scale × DRAWDOWN_BOOST_W(1.5, =0.3×NAV天然
    等于单仓cap上限):
      ① boost_active=true(盘后状态机: dd>=15%进入, nav回峰值dd<=0退出)
      ② 非冰点日: D-1非ST涨停家数>=ICE —— 与冰点判定同源, 复用
        pos_scale['limitup_cnt']同一次计算; 不可得(降级日)保守不boost
      ③ 无其它减仓在身(final_scale>=1.0): 冰点ice优先/回撤guard L1-L3
        优先, boost一律让位(ENGINE_REPORT §8 ice优先语义)
    铁律兜底: 状态缺失/损坏/任何异常 → 不加仓按原系数运行+ERROR日志。
    留痕写入 pos_scale['boost'] (decision json审计链)。
    """
    boost = {'enabled': DRAWDOWN_BOOST_ENABLED, 'active': False,
             'factor': 1.0, 'drawdown_pct': None, 'nav_peak': None,
             'skip_reason': None}
    try:
        if not DRAWDOWN_BOOST_ENABLED:
            boost['skip_reason'] = 'disabled'
            pos_scale['boost'] = boost
            return pos_scale
        try:
            with open(DRAWDOWN_BOOST_STATE_FILE, encoding='utf-8') as f:
                st = json.load(f)
            if not isinstance(st, dict):
                raise ValueError('drawdown_state非dict')
        except Exception as e:
            print(f"  [boost] 状态文件读取失败({e!r}), "
                  f"按boost_active=false正常运行")
            boost['skip_reason'] = f'state_unreadable: {e!r}'
            pos_scale['boost'] = boost
            return pos_scale
        boost['drawdown_pct'] = st.get('drawdown_pct')
        boost['nav_peak'] = st.get('nav_peak')
        if not bool(st.get('boost_active')):
            boost['skip_reason'] = 'boost_active=false'
            pos_scale['boost'] = boost
            return pos_scale
        cnt = pos_scale.get('limitup_cnt')
        if cnt is None or cnt < POSITION_SCALE_ICE:
            boost['skip_reason'] = (f'冰点日ice优先boost让位'
                                    f'(limitup_cnt={cnt})')
            print(f"  [boost] 回撤{st.get('drawdown_pct')}%处于boost态, "
                  f"但{boost['skip_reason']}")
            pos_scale['boost'] = boost
            return pos_scale
        if pos_scale.get('final_scale', 1.0) < 1.0 or pos_scale.get('halt'):
            boost['skip_reason'] = (f"其它减仓在身让位"
                                    f"(final_scale={pos_scale.get('final_scale')}"
                                    f", halt={pos_scale.get('halt')})")
            print(f"  [boost] {boost['skip_reason']}")
            pos_scale['boost'] = boost
            return pos_scale
        pos_scale['final_scale'] = round(
            pos_scale['final_scale'] * DRAWDOWN_BOOST_W, 4)
        boost['active'] = True
        boost['factor'] = DRAWDOWN_BOOST_W
        print(f"  ★ [boost] 回撤加仓生效: 盘后回撤"
              f"{st.get('drawdown_pct')}%>=阈值{DRAWDOWN_BOOST_X}%且非冰点日 "
              f"→ 今日新开仓金额×{DRAWDOWN_BOOST_W} "
              f"(最终系数={pos_scale['final_scale']}, =0.3×NAV单仓cap)")
    except Exception as e:
        # 铁律: boost任何异常绝不炸断主链, 降级回原系数0行为
        print(f"  [ERROR][boost] 异常降级不加仓(按原系数运行): {e!r}")
        boost = {'enabled': DRAWDOWN_BOOST_ENABLED, 'active': False,
                 'factor': 1.0, 'drawdown_pct': None, 'nav_peak': None,
                 'skip_reason': f'exception: {e!r}'}
    pos_scale['boost'] = boost
    return pos_scale


