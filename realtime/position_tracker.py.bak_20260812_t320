def confirm_buy():
    """确认买入pending记录，转入正式持仓。使用动态再平衡分配资金。"""
    pending = load_pending()
    if not pending:
        print("[position_tracker] 无待确认的买入记录")
        return

    data = load_positions()
    account = data['account']

    print(f"\n确认买入以下股票 (动态再平衡模式):")
    print(f"  当前总净值: ¥{account['total_nav']:,.0f} | 可用现金: ¥{account['cash']:,.0f}")

    n_confirmed = 0
    for p in pending:
        # 动态再平衡: 每slot金额 = total_nav / 5 × 冰点系数(Task#68, 默认1.0)
        scale = p.get('position_scale') or 1.0
        buy_amount = round(get_buy_amount(data, scale=scale), 2)   # 取整后扣款, 与buy_amount记录一致
        slot_id = p.get('slot_id', '?')
        strategy = p.get('strategy', '?')

        if buy_amount < 10000:
            print(f"  [{slot_id}:{strategy}] {p['code']} {p['name']} - 跳过(资金不足)")
            continue

        # V-C杜绝先买后卖硬断言(用户裁决③): 买入时点现金必须≥买入额
        # (不计当日未来回款), 违反=拒单+告警, 绝不透支/缩水。
        # 正常不应触发(morning_decision.allocate_idle_slots已按空闲槽×现金
        # 预算分配), 触发=分配层与账本不一致的tripwire。
        if VC_DYNAMIC_SLOTS and buy_amount > account['cash'] + 0.01:
            msg = (f"[VC_CASH_GUARD] 拒单: [{slot_id}:{strategy}] {p['code']} "
                   f"{p['name']} 买入额¥{buy_amount:,.2f} > 现金"
                   f"¥{account['cash']:,.2f} (杜绝先买后卖, 不计当日未来回款)")
            print(f"  🚨 {msg}")
            try:
                with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
                    f.write(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                            f"🚨 {msg}\n")
            except OSError:
                pass
            continue

        if p.get('sell_mode') == 'timed':
            sa = p.get('sell_at') or {}
            sell_desc = (f"定时卖出 {sa.get('date','?')} {sa.get('time','?')}"
                         f"(无盘中TP/SL)")
        elif p.get('sell_mode') == 'trailing':
            sell_desc = (f"移动止盈(回落{p.get('trailing_pp') or 2.0}pp) "
                         f"SL={p['sl_price']:.2f}")
        else:
            tp_str = f"{p['tp_price']:.2f}" if p.get('tp_price') else '无'
            sell_desc = f"TP={tp_str} SL={p['sl_price']:.2f}"
        print(f"  [{slot_id}:{strategy}] {p['code']} {p['name']} "
              f"买入@{p['buy_price']:.2f} 金额¥{buy_amount:,.0f}"
              f"{f'(冰点×{scale})' if scale != 1.0 else ''} "
              f"{sell_desc}")

        # 扣减现金
        account['cash'] -= buy_amount

        data['positions'].append({
            'code': p['code'],
            'name': p['name'],
            'strategy': strategy,
            'slot_id': slot_id,
            'buy_date': p['buy_date'],
            'buy_price': p['buy_price'],
            'buy_amount': round(buy_amount, 2),
            'tp_price': p.get('tp_price'),
            'sl_price': p['sl_price'],
            'sell_mode': p.get('sell_mode', 'fixed'),
            'trailing_pp': p.get('trailing_pp'),
            'sell_at': p.get('sell_at'),        # timed用: {'date','time'} 定时卖出点
            'peak_price': p['buy_price'],   # trailing用: 持有期最高价(含买入价)
            'expire_date': p['expire_date'],
            # G2确认三参随持仓落盘: 2026-07-31批准(APPROVAL_G2_MINUTE)
            # (pending→持仓, 缺省全关; intraday_monitor据此分路)
            'confirm_bars': p.get('confirm_bars', 0),
            'confirm_before': p.get('confirm_before', ''),
            'confirm_scope': p.get('confirm_scope', 'trailing'),
            # weak_buy标记(Task#205 expam35): 弱市日买入的S2仓, 到期日
            # 早盘AM离场(evaluate_position gap判TP/SL); 旧仓无字段=false
            'weak_buy': bool(p.get('weak_buy', False)),
            'limitup_cnt_d1': p.get('limitup_cnt_d1'),
            'status': 'holding',
        })
        n_confirmed += 1

    save_positions(data)
    save_pending([])
    print(f"\n[OK] 已确认 {n_confirmed}/{len(pending)} 笔买入，持仓已更新"
          + (f"(跳过/拒单{len(pending) - n_confirmed}笔, 见上方日志)"
             if n_confirmed < len(pending) else ""))
    print(f"  更新后现金: ¥{account['cash']:,.0f} | 总净值: ¥{account['total_nav']:,.0f}")


