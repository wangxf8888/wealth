def _find_historical_sell_price(pos: dict, today: str) -> float:
    """用DB数据回溯查找持仓应在哪天以什么价格卖出(与回测挂单语义一致)。

    fixed模式: T+1后逐小时: SL(低越过以SL价), TP(高越过以TP价), 同小时保守SL优先;
    trailing模式: peak用已完成小时+当前小时open, 触发价=max(trailing, 硬SL);
    到期日按H4_close强平。
    """
    code = pos['code']
    buy_date = pos['buy_date']
    buy_price = pos.get('buy_price', 0)
    tp_price = pos.get('tp_price')
    sl_price = pos['sl_price']
    expire_date = pos['expire_date']
    sell_mode = pos.get('sell_mode', 'fixed')
    trailing_pp = pos.get('trailing_pp') or 2.0
    peak = pos.get('peak_price', buy_price)

    conn = sqlite3.connect(DATA_DB)
    cur = conn.execute("""
        SELECT date, open, close,
               hour1_open, hour1_high, hour1_low, hour1_close,
               hour2_open, hour2_high, hour2_low, hour2_close,
               hour3_open, hour3_high, hour3_low, hour3_close,
               hour4_open, hour4_high, hour4_low, hour4_close
        FROM stock_kline WHERE code = ? AND date > ? AND date <= ?
        ORDER BY date
    """, (code, buy_date, today))

    try:
        for row in cur.fetchall():
            date = row[0]
            day_close = row[2]
            hours = [row[3 + i * 4: 7 + i * 4] for i in range(4)]  # (o,h,l,c)×4

            if sell_mode == 'timed':
                # Task#36: 定时点(sell_at)日按hour1_close了结(=回测d2h1_close);
                # 之后的日子任意有效小时开盘价尽快卖出(deferred语义)
                due_date = (pos.get('sell_at') or {}).get('date') or expire_date
                if date < due_date:
                    continue
                if date == due_date:
                    h1 = hours[0]
                    p = h1[3] or h1[0]  # hour1_close, 缺则hour1_open
                    if p and p > 0:
                        return p
                    continue  # 当日停牌/无H1数据 → 顺延下一日
                for h_open, _h, _l, _c in hours:
                    if h_open and h_open > 0:
                        return h_open
                continue

            for h_open, h_high, h_low, h_close in hours:
                if not h_open or h_open <= 0:
                    continue

                if sell_mode == 'trailing':
                    # bar开始时已知peak(含当前bar open)
                    if h_open > peak:
                        peak = h_open
                    trigger = sl_price
                    if buy_price > 0 and peak > buy_price:
                        trigger = max(trigger,
                                      peak - buy_price * trailing_pp / 100.0)
                    if h_open <= trigger:
                        return h_open
                    if h_low and h_low > 0 and h_low <= trigger:
                        return trigger
                    if h_high and h_high > peak:
                        peak = h_high
                else:
                    # fixed: SL优先(保守), 再TP
                    if h_open <= sl_price:
                        return h_open
                    if tp_price and h_open >= tp_price:
                        return h_open
                    if h_low and h_low > 0 and h_low <= sl_price:
                        return sl_price
                    if tp_price and h_high and h_high > 0 and h_high >= tp_price:
                        return tp_price

            # 到期日强制卖出 - H4收盘
            if date >= expire_date:
                sell_p = hours[3][3] or day_close  # hour4_close or day_close
                return sell_p
    finally:
        conn.close()
    return None


def _guess_current_hour() -> int:
    """根据当前时间推测trading hour。"""
    now = datetime.now()
    h = now.hour
    m = now.minute
    if h < 10:
        return 1
    elif h < 11 or (h == 11 and m <= 30):
        return 2
    elif h < 14:
        return 3
    else:
        return 4


