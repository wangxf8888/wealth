def _assert_cash_conservation(data: dict):
    """现金守恒不变量: cash = initial_capital + Σclosed pnl_amount - Σholding buy_amount。

    每次现金变动必须可归因于可枚举交易流(买-/卖+), 容差1分;
    超差 -> 写告警日志 + 拒绝落盘(raise), 宁可中断也不让错账持久化。
    背景: 7/22建仓补录曾以错误基数985,740初始化现金, 少记¥14,260带到7/30才发现。
    """
    account = data.get('account') or {}
    if 'cash' not in account:
        return
    expected = (account.get('initial_capital', 0)
                + sum(t.get('pnl_amount') or 0 for t in data.get('closed_trades', []))
                - sum(p.get('buy_amount') or 0 for p in data.get('positions', [])
                      if p.get('status') == 'holding'))
    diff = account['cash'] - expected
    if abs(diff) > 0.010001:
        msg = (f"现金守恒断言失败: cash={account['cash']:.4f} 应为{expected:.4f} "
               f"(偏差{diff:+.4f}), 拒绝写入positions.json")
        line = (f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] "
                f"[CASH_GUARD] 🚨 {msg}")
        print(line)
        try:
            with open(f'{os.path.dirname(os.path.dirname(POSITIONS_FILE))}/../logs/realtime/scheduler_alerts.log', 'a') as f:
                f.write(line + '\n')
        except Exception:
            pass
        raise ValueError(msg)


def _update_account_nav(data: dict):
    """更新 account.total_nav = cash + 持仓市值(以买入价估算)。"""
    account = data.get('account', DEFAULT_ACCOUNT.copy())
    positions = data.get('positions', [])
    holdings = [p for p in positions if p.get('status') == 'holding']

    # 持仓市值: 用buy_price * buy_amount/buy_price = buy_amount (无实时价时)
    holding_value = sum(p.get('buy_amount', account['initial_capital'] / 5) for p in holdings)
    account['total_nav'] = account['cash'] + holding_value
    data['account'] = account


def get_buy_amount(data: dict, scale: float = 1.0) -> float:
    """动态再平衡: 每个slot的买入金额 = total_nav / 5 × scale。

    与回测引擎 portfolio.py 的逻辑一致:
      target_amount = self.get_nav() / self.n_slots
    scale(Task#68): 冰点减仓overlay系数(默认1.0零侵入),
    与回测 position_scale.PositionScaler 同语义(只影响新开仓金额)。
    """
    account = data.get('account', DEFAULT_ACCOUNT.copy())
    positions = data.get('positions', [])
    holdings = [p for p in positions if p.get('status') == 'holding']

    # total_nav = cash + 持仓市值
    holding_value = sum(p.get('buy_amount', account['initial_capital'] / 5) for p in holdings)
    total_nav = account['cash'] + holding_value

    buy_amount = total_nav / 5 * scale
    if VC_DYNAMIC_SLOTS:
        # V-C(用户裁决2026-07-31): 不缩水不钳制 —— 现金不足由confirm_buy
        # 硬断言拒单(杜绝先买后卖), 此处min(cash)缩水语义废除
        return buy_amount
    # 现行路径: 不能超过可用现金(缩水买, V-C切换后不再走到)
    buy_amount = min(buy_amount, account['cash'])
    return buy_amount


