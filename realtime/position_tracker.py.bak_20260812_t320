# 盘中守护进程(realtime/intraday_monitor.py)心跳协调:
# daemon每轮询(10s, 退避时30s)写心跳; cron auto-close看到新鲜心跳(<60s)则跳过,
# 由daemon负责; 心跳超时(daemon死亡)→cron接管并写scheduler_alerts.log
# (10分钟scheduler会展示)
HEARTBEAT_FILE = os.path.join(PROJECT_ROOT, 'logs', 'realtime',
                              'intraday_monitor_heartbeat')
DAEMON_STALE_SEC = 60
SCHEDULER_ALERT_LOG = os.path.join(PROJECT_ROOT, 'logs', 'realtime',
                                   'scheduler_alerts.log')
_DAEMON_DOWN_MARK = os.path.join(PROJECT_ROOT, 'logs', 'realtime',
                                 '.intraday_daemon_down_alerted')


def daemon_heartbeat_age() -> float:
    """守护进程心跳文件距今秒数; 无心跳文件返回None。"""
    try:
        return time.time() - os.path.getmtime(HEARTBEAT_FILE)
    except OSError:
        return None


def alert_daemon_down(age):
    """daemon心跳超时告警(写scheduler_alerts.log, 每日去重)。

    仅在交易时段内应告警(15:00后daemon自然退出属正常), 由调用方把关时段。
    """
    today = datetime.now().strftime('%Y-%m-%d')
    try:
        if os.path.exists(_DAEMON_DOWN_MARK):
            with open(_DAEMON_DOWN_MARK, 'r') as f:
                if f.read().strip() == today:
                    return  # 今日已告警过
        age_desc = f"{age:.0f}s前" if age is not None else "从未写入"
        ts = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        with open(SCHEDULER_ALERT_LOG, 'a', encoding='utf-8') as f:
            f.write(f"[{ts}] ⚠️ 盘中监控守护进程心跳超时(最后心跳{age_desc}, "
                    f"阈值{DAEMON_STALE_SEC}s), cron已接管卖出检查; "
                    f"请检查 intraday_monitor.py (log: intraday_monitor.log)\n")
        with open(_DAEMON_DOWN_MARK, 'w') as f:
            f.write(today)
        print(f"[cron接管] 守护进程心跳超时({age_desc}), "
              f"已写scheduler_alerts.log, cron兜底执行卖出检查")
    except OSError as e:
        print(f"[WARN] 写daemon心跳告警失败(非致命): {e}")


