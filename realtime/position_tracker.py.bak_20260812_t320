def check_positions(test_date: str = None, hour: int = None, auto_close: bool = False):
    """检查所有持仓, 输出止盈/止损/到期提醒。auto_close=True时自动平仓。"""
    data = load_positions()
    holdings = [p for p in data['positions'] if p['status'] == 'holding']

    if not holdings:
        print("\n[持仓跟踪] 当前无持仓")
        return

    today = test_date or datetime.now().strftime('%Y-%m-%d')
    current_hour = hour or _guess_current_hour()
    print(f"\n{'=' * 60}")
    print(f"  持仓跟踪 ({today} Hour={current_hour}) {'[AUTO-CLOSE]' if auto_close else ''}")
    print(f"{'=' * 60}")

    # 获取当前行情(price/open/high/low/preclose, 测试模式与实盘同构)
    codes = [p['code'] for p in holdings]
    if test_date:
        quotes = fetch_test_prices(codes, test_date, hour)
        # timed持仓判定需要"当前时刻": 测试模式按hour收盘时刻注入模拟时刻,
        # hourN_close价格与该时刻语义对齐(hour1_close即10:30价, =B2-A定时点)
        if hour in (1, 2, 3, 4):
            hm = {1: '10:30', 2: '11:30', 3: '14:00', 4: '15:00'}[hour]
            for q in quotes.values():
                q['_hm'] = hm
    else:
        quotes = fetch_realtime_quotes(codes)
    prices = {c: q['price'] for c, q in quotes.items()}

    actions = []
    state_changed = False  # peak/日初peak/告警标记等持久化字段有变更
    for pos in holdings:
        code = pos['code']
        name = pos['name']
        strategy_name = pos.get('strategy', '')
        expire_date = pos['expire_date']

        if code not in prices:
            # 对于过期仓位，尝试用DB回溯查找卖出价
            if today >= expire_date and auto_close:
                sell_price = _find_historical_sell_price(pos, today)
                if sell_price:
                    prices[code] = sell_price
                    quotes[code] = {'price': sell_price, 'high': sell_price}
                else:
                    print(f"\n  {code} {name} [{strategy_name}]: 无行情且无法回溯")
                    continue
            else:
                print(f"\n  {code} {name} [{strategy_name}]: 未获取到行情")
                continue

        # 共享判定(evaluate_position会原地更新pos的peak字段并打印状态行)
        res = evaluate_position(pos, quotes[code], today)
        if res['state_changed']:
            state_changed = True
        if res['missed']:
            if process_missed_alert(pos, res['missed'], quotes[code], today,
                                    persist=not test_date):
                state_changed = True
        if res.get('blocked'):
            # Task#286: 跌停封死顺延通知(当日去重), 不记成交不改账
            if process_blocked_alert(pos, quotes[code], today,
                                     persist=not test_date):
                state_changed = True
        if res['action_rec']:
            actions.append(res['action_rec'])

    # peak/日初peak/告警标记更新即使无卖出动作也要落盘(下次检查依赖);
    # 测试模式不写盘; auto-close路径稍后还会save(原子写, 重复无害)
    if state_changed and not test_date:
        save_positions(data)

    if actions:
        print(f"\n  --- 需要操作: {len(actions)} 笔 ---")
        for a in actions:
            print(f"  [{a['action']}] {a['code']} {a['name']} → 卖出@{a['sell_price']:.2f}")

        if auto_close:
            # 自动平仓 (动态再平衡: 资金回到现金池)
            # 重新加载最新持仓再平仓: 缩小与daemon的读-改-写双写窗口
            # (主防线是daemon心跳跳过, selling_locked先到者锁定是二道锁)
            data = load_positions()
            account = data['account']
            closed_count = 0
            # Task#185: 同批卖出代码集→卖出通知持仓栏剔除用(仅影响通知渲染)
            batch = [x['code'] for x in actions]
            for a in actions:
                if close_position_locked(data, a, today, owner='cron',
                                         batch_codes=batch):
                    closed_count += 1

            if closed_count:
                # 清理positions中已closed的
                data['positions'] = [p for p in data['positions']
                                     if p.get('status') != 'closed']
                account['realized_pnl'] = round(account['realized_pnl'], 2)
                account['cash'] = round(account['cash'], 2)
                save_positions(data)
                print(f"\n  [AUTO-CLOSE] 已自动平仓 {closed_count} 笔")
                print(f"  现金: ¥{account['cash']:,.0f} | 累计PnL: ¥{account['realized_pnl']:+,.0f}")
            else:
                print(f"\n  [AUTO-CLOSE] 0笔平仓(持仓已被守护进程锁定/平仓)")
        else:
