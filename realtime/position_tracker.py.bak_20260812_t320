def evaluate_position(pos: dict, quote: dict, today: str) -> dict:
    """单仓区间触线判定+peak更新(Task#20语义)。会原地更新pos的peak字段。

    quote: {'price','open','high','low','preclose'} (open/low缺失→退回快照比价)
    返回: {
      'skip': None|'T0'(买入当日禁卖, 仅展示),
      'action': None|'stop_loss'|'trailing_stop'|'take_profit'|'expired',
      'action_rec': action非None且未被跌停拦截时的卖出记录(供平仓用),
      'blocked': True=已跌停卖单无法成交, 顺延下次检查,
      'missed': None|{'trigger','sem_price','kind'} 错过的触发(告警不补记),
      'state_changed': peak/日初peak有更新需落盘,
    }
    """
    code = pos['code']
    name = pos['name']
    buy_price = pos['buy_price']
    tp_price = pos.get('tp_price')          # trailing模式为None
    sl_price = pos['sl_price']
    expire_date = pos['expire_date']
    strategy_name = pos.get('strategy', '')
    sell_mode = pos.get('sell_mode', 'fixed')
    trailing_pp = pos.get('trailing_pp') or 2.0

    current_price = quote['price']
    today_high = quote.get('high', current_price)
    today_low = quote.get('low', 0)
    today_open = quote.get('open', 0)
    pnl_pct = (current_price / buy_price - 1) * 100

    res = {'skip': None, 'action': None, 'action_rec': None,
           'blocked': False, 'missed': None, 'state_changed': False}

    # trailing模式: 更新持有期peak(买入日的冲高不计入, 与回测T+1语义一致)
    # peak_sod=日初peak(今日首次检查前的存量peak), 区间触及判定用它——
    # 挂单语义: 当日低点发生时, 盘中新高抬升的触发线可能尚不存在
    if sell_mode == 'trailing' and today > pos.get('buy_date', today):
        if pos.get('peak_date') != today:
            pos['peak_sod'] = pos.get('peak_price', buy_price)
            pos['peak_date'] = today
            res['state_changed'] = True
        old_peak = pos.get('peak_price', buy_price)
        new_peak = max(old_peak, today_high, current_price)
        if new_peak > old_peak:
            pos['peak_price'] = round(new_peak, 3)
            res['state_changed'] = True

    # T+1: 买入当日不可卖出, 只展示
    if pos.get('buy_date', '') == today:
        print(f"\n  持仓(T+0禁卖): {code} {name} [{strategy_name}] "
              f"浮盈{pnl_pct:+.1f}% | 当前{current_price:.2f}")
        res['skip'] = 'T0'
        return res

    # 区间判定适用条件: 行情含有效当日open/low(竞价期或历史回溯路径
    # 可能缺失→退回快照比价); T+0持仓已在上面跳过, 当日区间必属持有期
    use_range = today_open > 0 and today_low > 0

    # 判断动作(区间触及判定, 回测语义: 条件单全程挂着, 盘中触及即成交)
    # 语义卖价: 开盘已越过触发价→按开盘价(跳空击穿), 否则按触发价(盘中击穿)
    action = None
    sell_price = current_price
    missed = None  # 错过的触发: 盘中已触及但现价已脱离触发区 → 只告警不补记
    if sell_mode == 'timed':
        # Task#36(B2-A): 定时了结, 无盘中TP/SL/peak。到点(sell_at)按现价卖出;
        # daemon 10s轮询到点即触发, cron 10:31班兜底同走此分支;
        # 跨日未卖(跌停封死顺延/停牌)→ 之后任意检查即刻卖出(尽快, =回测deferred)。
        # quote['_hm']可注入模拟时刻(测试模式), 缺省用当前真实时刻。
        due = pos.get('sell_at') or {}
        due_date = due.get('date') or expire_date
        due_time = due.get('time') or '10:30'
        now_hm = quote.get('_hm') or datetime.now().strftime('%H:%M')
        if today > due_date or (today == due_date and now_hm >= due_time):
            action = 'expired'
            sell_price = current_price
            print(f"\n  ★ 定时卖出: {code} {name} [{strategy_name}] "
                  f"定时点{due_date} {due_time} 现价{current_price:.2f} "
                  f"盈亏{pnl_pct:+.1f}%")
        else:
            print(f"\n  持仓(定时): {code} {name} [{strategy_name}] "
                  f"浮盈{pnl_pct:+.1f}% | 当前{current_price:.2f} "
                  f"定时卖出:{due_date} {due_time}")
    elif sell_mode == 'trailing':
        peak_price = pos.get('peak_price', buy_price)
        peak_sod = pos.get('peak_sod', peak_price)
        # 日初挂单触发线: max(硬SL, 日初peak回落线)
        trigger_sod = sl_price
        if peak_sod > buy_price:
            trigger_sod = max(trigger_sod,
                              peak_sod - buy_price * trailing_pp / 100.0)
        # 当前触发线(含今日新高抬升后的回落线): 快照比价用
        trigger_now = sl_price
        if peak_price > buy_price:
            trigger_now = max(trigger_now,
                              peak_price - buy_price * trailing_pp / 100.0)

        range_touched = use_range and today_low <= trigger_sod
        if current_price <= trigger_now:
            # 现价仍处触发区 → 立即可执行
            if range_touched and current_price <= trigger_sod:
                # 日初挂单线盘中已触及且现价未回升到线上 → 挂单语义已成交,
                # 按语义价记录(开盘击穿按开盘价, 盘中击穿按触发价)
                sell_price = (today_open if today_open < trigger_sod
                              else trigger_sod)
                ref_trigger = trigger_sod
            else:
                # 盘中新高抬升后的回落线实时触发(或无区间数据) → 按现价卖出
                sell_price = current_price
                ref_trigger = trigger_now
            action = ('stop_loss' if sell_price <= sl_price
                      else 'trailing_stop')
            label = '止损' if action == 'stop_loss' else '移动止盈'
            print(f"\n  ★ {label}: {code} {name} [{strategy_name}] "
                  f"当日low{today_low:.2f}/现价{current_price:.2f} "
                  f"触发线{ref_trigger:.2f} "
                  f"语义卖价{sell_price:.2f} "
                  f"盈亏{(sell_price / buy_price - 1) * 100:+.1f}%")
        elif range_touched:
            # 日初线盘中已被击穿但现价已回升到当前触发线之上 → 错过的触发,
            # 只告警不补记(今天实际没卖)
            missed = {'trigger': trigger_sod,
                      'sem_price': (today_open if today_open < trigger_sod
                                    else trigger_sod),
                      'kind': ('止损' if trigger_sod <= sl_price
                               else '移动止盈')}
        elif today >= expire_date:
            action = 'expired'
            print(f"\n  ★ 到期: {code} {name} [{strategy_name}] "
                  f"到期{expire_date} 浮盈{pnl_pct:+.1f}%")
        else:
            print(f"\n  持仓: {code} {name} [{strategy_name}] "
                  f"浮盈{pnl_pct:+.1f}% | 当前{current_price:.2f} "
                  f"高点:{peak_price:.2f} 回落卖:{trigger_now:.2f} "
                  f"SL:{sl_price:.2f} 到期:{expire_date}")
    else:
        # fixed: SL优先(保守), 再TP
        # AM离场通道(Task#205 expam35): weak_buy仓(弱市日买入的S2)到期日
        # 以开盘价gap先判TP/SL再到期, 语义对齐回测QAExpAM(D+2首hour以
        # open判: open>=TP→take_profit, open<=SL→stop_loss, 否则expired,
        # 均按开盘价为语义卖价)。旧仓无weak_buy字段=false走下方旧逻辑。
        # 铁律兜底: 任何异常→降级回旧到期/触线逻辑+ERROR日志。
        am_action = None
        try:
            if pos.get('weak_buy') and today >= expire_date:
                _o = today_open if today_open > 0 else current_price
                if tp_price and _o >= tp_price:
                    am_action = 'take_profit'
                elif _o <= sl_price:
                    am_action = 'stop_loss'
                else:
                    am_action = 'expired'
                sell_price = _o
        except Exception as e:
            am_action = None
            sell_price = current_price
            print(f"    [ERROR][AM离场] {code} 判定异常({e!r}), "
                  f"降级旧到期逻辑")
        sl_touched = (use_range and today_low <= sl_price)
        tp_touched = (tp_price and use_range and today_high >= tp_price)
        if am_action:
            action = am_action
            _lbl = {'take_profit': '止盈', 'stop_loss': '止损',
                    'expired': '到期'}[am_action]
            print(f"\n  ★ AM离场({_lbl}): {code} {name} [{strategy_name}] "
                  f"弱市仓到期{expire_date} 开盘{sell_price:.2f} "
                  f"gap判TP/SL→{am_action} "
                  f"盈亏{(sell_price / buy_price - 1) * 100:+.1f}%")
        elif current_price <= sl_price or sl_touched:
            if current_price <= sl_price:
                action = 'stop_loss'
                sell_price = ((today_open if today_open < sl_price
                               else sl_price) if sl_touched
                              else current_price)
                print(f"\n  ★ 止损: {code} {name} [{strategy_name}] "
                      f"当日low{today_low:.2f}/现价{current_price:.2f} "
                      f"<= SL{sl_price:.2f} 语义卖价{sell_price:.2f} "
                      f"亏损{(sell_price / buy_price - 1) * 100:.1f}%")
            else:
                missed = {'trigger': sl_price,
                          'sem_price': (today_open if today_open < sl_price
                                        else sl_price),
                          'kind': '止损'}
        elif tp_price and (current_price >= tp_price or tp_touched):
            if current_price >= tp_price:
                action = 'take_profit'
                sell_price = ((today_open if today_open > tp_price
                               else tp_price) if tp_touched
                              else current_price)
                print(f"\n  ★ 止盈: {code} {name} [{strategy_name}] "
                      f"当日high{today_high:.2f}/现价{current_price:.2f} "
                      f">= TP{tp_price:.2f} 语义卖价{sell_price:.2f} "
                      f"盈利{(sell_price / buy_price - 1) * 100:+.1f}%")
            else:
                missed = {'trigger': tp_price,
                          'sem_price': (today_open if today_open > tp_price
                                        else tp_price),
                          'kind': '止盈'}
        elif today >= expire_date:
            action = 'expired'
            print(f"\n  ★ 到期: {code} {name} [{strategy_name}] "
                  f"到期{expire_date} 浮盈{pnl_pct:+.1f}%")
        else:
            tp_str = f"{tp_price:.2f}" if tp_price else '无'
            print(f"\n  持仓: {code} {name} [{strategy_name}] "
                  f"浮盈{pnl_pct:+.1f}% | 当前{current_price:.2f} "
                  f"TP:{tp_str} SL:{sl_price:.2f} 到期:{expire_date}")

    # 到期日与错过触发重叠时, 到期强平优先(不能拖过到期日)
    if missed and today >= expire_date:
        action = 'expired'
        missed = None
        print(f"\n  ★ 到期: {code} {name} [{strategy_name}] "
              f"到期{expire_date} 浮盈{pnl_pct:+.1f}%")

    if action:
        # 框架级兜底: 已封跌停 → 卖单排队卖不掉, 顺延下次检查(到期强平同理)
        # Task#286可卖性闸门增强: ①limit_prices舍入修复后跌停价逐分精确;
        # ②盘口二次确认——跌停价上买一仍有承接(bid1_vol>0)时卖单可真实
        # 成交, 按跌停价(现价)即卖; 仅"现价触跌停且买一空"=封死才顺延;
        # 盘口缺失(测试/历史回溯路径)保守顺延。开板(现价>跌停价)后
        # 后续轮次自动走下方else分支按原路径语义真卖。
        preclose = quote.get('preclose', 0)
        if trading_rules.is_at_limit_down(
                code, current_price, preclose,
                is_st=trading_rules.is_st_name(name)):
            bid1_vol = quote.get('bid1_vol') or 0
            if bid1_vol > 0:
                # 跌停价上买盘有承接 → 可卖, 成交价保守取跌停价(现价)
                sell_price = current_price
                print(f"    [闸门放行] {code} {name} 现价{current_price:.2f}"
                      f"触跌停但买一有承接({bid1_vol:.0f}手), 按跌停价卖出")
                res['action_rec'] = {
                    'code': code,
                    'name': name,
                    'strategy': strategy_name,
                    'action': action,
                    'current_price': current_price,
                    'sell_price': round(sell_price, 2),
                    'pnl_pct': round((sell_price / buy_price - 1) * 100, 2),
                }
            else:
                print(f"    [框架拦截] {code} {name} 当前{current_price:.2f}"
                      f"已跌停且买一空(封死), 卖单无法成交, 顺延下次检查")
                res['blocked'] = True
        else:
            res['action_rec'] = {
                'code': code,
                'name': name,
                'strategy': strategy_name,
                'action': action,
                'current_price': current_price,
                'sell_price': round(sell_price, 2),
                'pnl_pct': round((sell_price / buy_price - 1) * 100, 2),
            }
    res['action'] = action
    res['missed'] = missed
    return res


def process_missed_alert(pos: dict, missed: dict, quote: dict, today: str,
                         persist: bool = True) -> bool:
    """错过的触发: 盘中已触及触发价但现价已回到安全区。今天实际没卖,
    不自动补记卖出, 显著告警+企微通知, 等人工决策。幂等: 同日同触发只告警一次。
    persist=False(测试模式)不落幂等标记不发通知。返回是否有状态变更需落盘。
    """
    code = pos['code']
    name = pos['name']
    buy_price = pos['buy_price']
    strategy_name = pos.get('strategy', '')
    expire_date = pos['expire_date']
    current_price = quote['price']
    today_low = quote.get('low', 0)
    today_open = quote.get('open', 0)
    pnl_pct = (current_price / buy_price - 1) * 100

    alert_key = f"{today}:{missed['kind']}:{missed['trigger']:.2f}"
    sem_pnl = (missed['sem_price'] / buy_price - 1) * 100
    if pos.get('missed_alert_key') == alert_key:
        print(f"\n  ⚠ 错过的触发(已告警, 幂等跳过): {code} {name} "
              f"当日low{today_low:.2f}触及{missed['kind']}线"
              f"{missed['trigger']:.2f}, 现价{current_price:.2f} "
              f"等人工决策")
        return False
    alert_msg = (
        f"⚠️【错过的触发-需人工决策】\n"
        f"• {pos.get('slot_id','?')} {name}({code}) "
        f"[{strategy_name}]\n"
        f"  该仓按规则应已于{'开盘' if missed['sem_price'] == today_open else '盘中'}"
        f"卖出{missed['sem_price']:.2f}"
        f"({missed['kind']}线{missed['trigger']:.2f}已被"
        f"当日{'低点' if missed['kind'] != '止盈' else '高点'}击穿), "
        f"实盘未触发\n"
        f"  当前{current_price:.2f}(浮盈{pnl_pct:+.2f}%), "
        f"语义卖价对应盈亏{sem_pnl:+.2f}%\n"
        f"  建议人工决策: ①立即卖出锁定{pnl_pct:+.2f}%浮盈 "
        f"②继续持有至到期{expire_date}")
    print(f"\n  {'!' * 56}")
    for _line in alert_msg.split('\n'):
        print(f"  {_line}")
    print(f"  {'!' * 56}")
    if persist:
        pos['missed_alert_key'] = alert_key
        try:
            from realtime.notify import send_text
            send_text(alert_msg)
        except Exception as e:
            print(f"  [notify] 告警通知发送失败(非致命): {e}")
        return True
    return False


def process_blocked_alert(pos: dict, quote: dict, today: str,
                          persist: bool = True) -> bool:
    """跌停封死顺延(Task#286): 卖出动作被可卖性闸门拦截, 通知一次(当日去重)。

    不记成交不改账, 仅落幂等标记+推送"跌停封死顺延"通知; 后续每轮检查
    开板(现价>跌停价或买一有承接)即按原路径语义真卖。
    persist=False(测试模式)不落标记不发通知。返回是否有状态变更需落盘。"""
    code = pos['code']
    name = pos['name']
    alert_key = f"{today}:limitdown_defer"
    if pos.get('limitdown_defer_key') == alert_key:
        return False
    current_price = quote['price']
    pnl_pct = (current_price / pos['buy_price'] - 1) * 100
    alert_msg = (
        f"⏸️【跌停封死·卖出顺延】\n"
        f"• {pos.get('slot_id','?')} {name}({code}) "
        f"[{pos.get('strategy','')}]\n"
        f"  卖出条件已触发, 但当前{current_price:.2f}跌停封死(买一空), "
        f"卖单无法成交\n"
        f"  浮盈{pnl_pct:+.2f}% | 不记成交, 持仓保留, 开板即卖; "
        f"全天封死则顺延至下一交易日")
    print(f"    [顺延通知] {code} {name} 跌停封死卖出顺延(当日首次, 已推送)")
    if persist:
        pos['limitdown_defer_key'] = alert_key
        try:
            from realtime.notify import send_text, send_qywx
            send_text(alert_msg)
            send_qywx(alert_msg)
        except Exception as e:
            print(f"  [notify] 顺延通知发送失败(非致命): {e}")
        return True
    return False


def close_position_locked(data: dict, a: dict, today: str,
                          owner: str = 'cron',
                          batch_codes: list = None) -> bool:
    """按action记录平仓一笔(动态再平衡: 资金回现金池+企微通知+移closed_trades)。

    selling_locked幂等锁: 先到者(daemon或cron)锁定, 他方跳过, 防双写;
    已closed/已被他方锁定的直接返回False。调用方负责最终save_positions。
    batch_codes: 同批卖出标的代码列表(可选, Task#185), 仅透传给卖出通知
    的持仓栏渲染(通知先于落账save, 持仓栏需显式剔除本笔及同批已卖标的),
    不影响任何落账逻辑。
    """
    account = data['account']
    for pos in data['positions']:
        if pos['code'] == a['code'] and pos['status'] == 'holding':
            lock = pos.get('selling_locked')
            if lock and lock.get('owner') != owner:
                print(f"  [幂等锁] {pos['code']} {pos.get('name','')} "
                      f"已被{lock.get('owner')}于{lock.get('ts')}锁定卖出, "
                      f"跳过防双写")
                return False
            pos['selling_locked'] = {
                'owner': owner,
                'ts': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            }
            pos['status'] = 'closed'
            pos['sell_date'] = today
            pos['sell_price'] = a['sell_price']
            pos['sell_reason'] = a['action']
            pos['pnl_pct'] = a['pnl_pct']

            # 计算盈亏金额并更新account(先取整再入账, 与pnl_amount记录一致, 守恒断言可对平)
            buy_amount = pos.get('buy_amount', account['initial_capital'] / 5)
            pnl_amount = round(buy_amount * (a['pnl_pct'] / 100.0), 2)
            pos['pnl_amount'] = pnl_amount

            proceeds = buy_amount + pnl_amount
            account['cash'] += proceeds
            account['realized_pnl'] += pnl_amount

            # 移到closed_trades(保留selling_locked作平仓归属审计)
            closed_record = pos.copy()
            del closed_record['status']
            data['closed_trades'].append(closed_record)

            # 发送卖出通知
            try:
                from realtime.notify import notify_sell
                buy_date_str = pos.get('buy_date', '')
                _hold_days = 0
                if buy_date_str:
                    try:
                        _d1 = datetime.strptime(buy_date_str, '%Y-%m-%d')
                        _d2 = datetime.strptime(today, '%Y-%m-%d')
                        _hold_days = (_d2 - _d1).days
                    except Exception:
                        _hold_days = 0
                notify_sell(
                    date_str=today,
                    time_str=datetime.now().strftime('%H:%M:%S'),
                    stock_name=pos.get('name', ''),
                    stock_code=pos['code'],
                    sell_price=a['sell_price'],
                    buy_price=pos['buy_price'],
                    hold_days=_hold_days,
                    sold_codes=batch_codes,
                )
            except Exception as e:
                print(f"[position_tracker] 卖出通知发送失败(非致命): {e}")
            return True
    return False


