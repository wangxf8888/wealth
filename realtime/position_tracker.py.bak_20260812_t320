def code_to_sina(code: str) -> str:
    return code.replace('.', '')


def sina_to_code(sina_code: str) -> str:
    return sina_code[:2] + '.' + sina_code[2:]


def fetch_realtime_quotes(codes: list) -> dict:
    """通过腾讯实时行情获取
    {code: {'price': 当前价, 'open': 今开, 'high': 今日最高,
            'low': 今日最低, 'preclose': 昨收,
            'bid1': 买一价, 'bid1_vol': 买一量(手)}}。

    high/low/open 用于区间触及判定(回测语义: 条件单全程挂着, 盘中触及即成交)
    与 trailing 止盈的盘中 peak 跟踪(两次检查间的冲高不会丢失);
    preclose 用于框架级涨跌停判定(跌停不可卖);
    bid1/bid1_vol(Task#286) 用于跌停封死盘口二次确认(买一空=封死不可卖,
    买一有承接=跌停价仍可成交)。qt字段[9]买一价 [10]买一量。
    竞价期 open/low 可能为0, 调用方需据此退回快照比价。
    """
    if not codes:
        return {}
    tencent_codes = [code_to_sina(c) for c in codes]
    results = {}
    batch_size = 50

    for i in range(0, len(tencent_codes), batch_size):
        batch = tencent_codes[i:i + batch_size]
        url = f"http://qt.gtimg.cn/q={','.join(batch)}"
        try:
            req = urllib.request.Request(url)
            req.add_header('User-Agent',
                           'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36')
            resp = urllib.request.urlopen(req, timeout=10)
            content = resp.read().decode('gbk')
            for line in content.strip().split('\n'):
                line = line.strip()
                if not line:
                    continue
                m = re.match(r'v_(\w+)="(.*)"', line)
                if not m:
                    continue
                tencent_sym = m.group(1)
                data_str = m.group(2)
                if not data_str:
                    continue
                parts = data_str.split('~')
                if len(parts) < 4:
                    continue
                code = sina_to_code(tencent_sym)
                try:
                    current = float(parts[3]) if parts[3] else 0
                except (ValueError, IndexError):
                    current = 0
                high = 0.0
                if len(parts) > 33:
                    try:
                        high = float(parts[33]) if parts[33] else 0
                    except (ValueError, IndexError):
                        high = 0.0
                low = 0.0
                if len(parts) > 34:
                    try:
                        low = float(parts[34]) if parts[34] else 0
                    except (ValueError, IndexError):
                        low = 0.0
                open_p = 0.0
                if len(parts) > 5:
                    try:
                        open_p = float(parts[5]) if parts[5] else 0
                    except (ValueError, IndexError):
                        open_p = 0.0
                preclose = 0.0
                if len(parts) > 4:
                    try:
                        preclose = float(parts[4]) if parts[4] else 0
                    except (ValueError, IndexError):
                        preclose = 0.0
                bid1 = bid1_vol = 0.0
                if len(parts) > 10:
                    try:
                        bid1 = float(parts[9]) if parts[9] else 0
                        bid1_vol = float(parts[10]) if parts[10] else 0
                    except (ValueError, IndexError):
                        bid1 = bid1_vol = 0.0
                if current > 0:
                    results[code] = {'price': current,
                                     'open': open_p,
                                     'high': high if high > 0 else current,
                                     'low': low,
                                     'preclose': preclose,
                                     'bid1': bid1,
                                     'bid1_vol': int(bid1_vol)}
        except Exception as e:
            print(f"  [WARN] 腾讯接口请求失败: {e}")

    return results


def fetch_realtime_prices(codes: list) -> dict:
    """兼容接口: 仅返回 {code: 当前价}。"""
    quotes = fetch_realtime_quotes(codes)
    return {c: q['price'] for c, q in quotes.items()}


def _fetch_test_precloses(codes: list, test_date: str) -> dict:
    """(已废弃, 保留兼容) 测试模式: 从DB取指定日期的preclose。
    fetch_test_prices 现已直接返回 preclose 字段。"""
    if not codes:
        return {}
    conn = sqlite3.connect(DATA_DB)
    placeholders = ','.join(['?' for _ in codes])
    cur = conn.execute(f"""
        SELECT code, preclose FROM stock_kline
        WHERE date = ? AND code IN ({placeholders})
    """, [test_date] + codes)
    results = {row[0]: row[1] for row in cur.fetchall() if row[1] and row[1] > 0}
    conn.close()
    return results


def fetch_test_prices(codes: list, test_date: str, hour: int = None) -> dict:
    """从数据库获取测试行情, 返回与fetch_realtime_quotes同构的
    {code: {'price','open','high','low','preclose'}}。

    hour指定则price取hour{N}_close(high/low取截至该小时的累计值,
    模拟盘中检查时腾讯接口的当日累计high/low), 否则取日close与全日high/low。
    """
    if not codes:
        return {}
    conn = sqlite3.connect(DATA_DB)
    placeholders = ','.join(['?' for _ in codes])
    cur = conn.execute(f"""
        SELECT code, open, high, low, close, preclose,
               hour1_high, hour1_low, hour1_close,
               hour2_high, hour2_low, hour2_close,
               hour3_high, hour3_low, hour3_close,
               hour4_high, hour4_low, hour4_close
        FROM stock_kline
        WHERE date = ? AND code IN ({placeholders})
    """, [test_date] + codes)
    results = {}
    for row in cur.fetchall():
        code, d_open, d_high, d_low, d_close, preclose = row[0:6]
        hours = [row[6 + i * 3: 9 + i * 3] for i in range(4)]  # (h,l,c)×4
        if hour and hour in (1, 2, 3, 4):
            # 盘中检查: price=该小时close, high/low=当日累计(开盘至该小时)
            h_high, h_low, h_close = hours[hour - 1]
            if not h_close or h_close <= 0:
                continue
            highs = [h[0] for h in hours[:hour] if h[0] and h[0] > 0]
            lows = [h[1] for h in hours[:hour] if h[1] and h[1] > 0]
            results[code] = {
                'price': h_close,
                'open': d_open or 0,
                'high': max(highs) if highs else h_close,
                'low': min(lows) if lows else h_close,
                'preclose': preclose or 0,
            }
        else:
            if not d_close or d_close <= 0:
                continue
            results[code] = {
                'price': d_close,
                'open': d_open or 0,
                'high': d_high or d_close,
                'low': d_low or d_close,
                'preclose': preclose or 0,
            }
    conn.close()
    return results


