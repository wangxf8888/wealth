def _prev_close_map(codes: list, today: str) -> dict:
    """从stocks.db(只读)取各股今日之前最近交易日收盘价 {code: prev_close}。

    只读mode=ro打开且仅查date<today, 不依赖当日数据回补进度、
    不干扰并行写入(daily_update链)。查不到的code不入map。
    """
    result = {}
    try:
        conn = sqlite3.connect(f'file:{DATA_DB}?mode=ro', uri=True)
        for code in codes:
            row = conn.execute(
                "SELECT close FROM stock_kline WHERE code=? AND date<? "
                "ORDER BY date DESC LIMIT 1", (code, today)).fetchone()
            if row and row[0]:
                result[code] = float(row[0])
        conn.close()
    except sqlite3.Error as e:
        print(f"[盘后日报] 昨收查询失败(非致命): {e}")
    return result


def update_drawdown_boost_state(today: str, today_nav: float):
    """盘后滚动更新 drawdown-boost 状态机(Task#205, t174 ENGINE_REPORT §8)。

    盯市nav → data/drawdown_state.json (与Task#73回撤作战手册的
    data/realtime/drawdown_state.json 是两个文件, 互不干扰):
      peak = max(旧peak, 今日nav); dd = (peak - nav) / peak × 100
      进入: 非boost态且 dd >= DRAWDOWN_BOOST_X(15%) → boost_active=true
      退出: boost态且 nav回到峰值(dd <= 0) → boost_active=false
    次日9:25 morning_decision.apply_drawdown_boost 读此状态(dd_{t-1}语义)。
    铁律兜底: 文件缺失/损坏→以今日nav保守重建(boost_active=false起步);
    任何异常只ERROR日志, 绝不影响日报/交易主链。幂等: 同nav重复调用无副作用。
    """
    try:
        if not DRAWDOWN_BOOST_ENABLED:
            return
        if not today_nav or today_nav <= 0:
            print(f"[boost状态] nav非法({today_nav}), 跳过更新")
            return
        st = {}
        try:
            with open(DRAWDOWN_BOOST_STATE_FILE, encoding='utf-8') as f:
                st = json.load(f)
            if not isinstance(st, dict):
                st = {}
        except (OSError, ValueError):
            # 缺失/损坏 → 以今日nav保守重建(boost_active=false起步)
            print(f"[boost状态] 状态文件缺失/损坏, 以今日nav保守重建")
            st = {}
        try:
            old_peak = float(st.get('nav_peak') or 0)
        except (TypeError, ValueError):
            old_peak = 0.0
        peak = max(old_peak, float(today_nav))
        dd = (peak - today_nav) / peak * 100 if peak > 0 else 0.0
        active = bool(st.get('boost_active', False))
        if not active and dd >= DRAWDOWN_BOOST_X:
            active = True
            print(f"[boost状态] ★ 进入boost态: 回撤{dd:.2f}%>="
                  f"{DRAWDOWN_BOOST_X}% → 次日非冰点日新开仓×1.5")
        elif active and dd <= 0:
            active = False
            print(f"[boost状态] ★ 退出boost态: nav回到峰值¥{peak:,.2f}")
        new_st = {
            'nav_peak': round(peak, 2),
            'nav_current': round(float(today_nav), 2),
            'drawdown_pct': round(dd, 2),
            'boost_active': active,
            'updated_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
        }
        tmp = DRAWDOWN_BOOST_STATE_FILE + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(new_st, f, ensure_ascii=False, indent=2)
        os.replace(tmp, DRAWDOWN_BOOST_STATE_FILE)
        print(f"[boost状态] {today} nav=¥{today_nav:,.2f} "
              f"peak=¥{peak:,.2f} dd={dd:.2f}% boost_active={active}")
    except Exception as e:
        # 铁律: 状态更新异常绝不影响盘后日报/交易主链
        print(f"[ERROR][boost状态] 更新异常(非致命): {e!r}")


def send_daily_report_if_due(today: str, force: bool = False, note: str = ''):
    """盘后日报: 15:00后auto-close首次运行时汇总当日交易并发企微通知。

    幂等: 标记文件记当日日期, 同日只发一次(发送成功才落标记);
    force=True跳过幂等检查允许重发(手工修正版用, note附到标题);
    非交易日(无当日candidates文件, 与daemon自判交易日同口径)跳过。

    今日收益口径(Task#126盯市mark-to-market, 账户级):
      今日收益% = (今日收盘净值 - 昨日收盘净值) / 昨日收盘净值
    分解为三部分贡献(每部分=金额差/昨日净值, 现金无贡献):
      卖出贡献: 今日卖出笔, (卖出价-昨收)x股数 —— T+1下今日卖的必是昨日前
        买入, 当日贡献基准是昨收而非买入价(买入价基准的pnl_pct是全周期
        盈亏, 仅用于笔明细展示, 两基准严格分离)
      续持贡献: 昨日已持有且今日未卖, (今收-昨收)x股数
      新买贡献: 今日买入, (今收-买入价)x股数
    数据源: 昨收=stocks.db stock_kline只读(date<today最近一条);
    今收=腾讯实时接口(盘后返回即收盘价, 不依赖库内当日数据)。
    昨日收盘净值由今日净值倒推: 昨净值=今净值(现金+持仓x今收)-三部分贡献金额
    (positions.json无历史nav快照, 倒推与昨现金+昨持仓x昨收独立重构一致,
    已手工交叉验证差<¥1)。
    """
    now = datetime.now()
    if now.strftime('%H:%M') < '15:00':
        return
    cand_file = os.path.join(OUTPUT_DIR,
                             f"candidates_{now.strftime('%Y%m%d')}.json")
    if not os.path.exists(cand_file):
        return
    if not force:
        try:
            if os.path.exists(_DAILY_REPORT_MARK):
                with open(_DAILY_REPORT_MARK, 'r') as f:
                    if f.read().strip() == today:
                        return  # 今日已发送
        except OSError:
            pass

    try:
        data = load_positions()
        holdings = [p for p in data.get('positions', [])
                    if p.get('status') == 'holding']
        sold_today = [t for t in data.get('closed_trades', [])
                      if t.get('sell_date') == today]

        # 价格源: 昨收(卖出股+续持股需要), 今收(全部持仓股需要)
        prev_closes = _prev_close_map(
            [t['code'] for t in sold_today] +
            [p['code'] for p in holdings if p.get('buy_date') != today], today)
        from realtime.notify import _fetch_realtime_prices, notify_daily_summary
        today_closes = _fetch_realtime_prices([p['code'] for p in holdings])

        trades_log = []
        # 当日买入(T+1下当日买入必仍在holding, 不会与卖出重复)
        for p in holdings:
            if p.get('buy_date') == today:
                trades_log.append({'action': 'buy',
                                   'name': p.get('name', ''),
                                   'code': p.get('code', ''),
                                   'price': p.get('buy_price', 0)})
        # 当日卖出(笔明细仍用买入价基准的全周期pnl_pct)
        sell_contrib = 0.0
        for t in sold_today:
            trades_log.append({'action': 'sell',
                               'name': t.get('name', ''),
                               'code': t.get('code', ''),
                               'price': t.get('sell_price', 0),
                               'pnl_pct': t.get('pnl_pct', 0)})
            buy_price = t.get('buy_price', 0)
            shares = (t.get('buy_amount', 0) / buy_price) if buy_price > 0 else 0
            # 昨收缺失时退化为买入价基准(旧口径, 仅兼容数据缺口)
            base = prev_closes.get(t['code'], buy_price)
            sell_contrib += (t.get('sell_price', 0) - base) * shares

        # 持仓浮动: 续持(昨收基准) + 新买(买入价基准); 同时累计今收市值
        carry_contrib = 0.0
        newbuy_contrib = 0.0
        holding_mv = 0.0
        for p in holdings:
            buy_price = p.get('buy_price', 0)
            if buy_price <= 0:
                continue
            shares = p.get('buy_amount', 0) / buy_price
            if p.get('buy_date') == today:
                # 今收缺失退化为买入价(贡献计0)
                tc = today_closes.get(p['code'], buy_price)
                newbuy_contrib += (tc - buy_price) * shares
            else:
                base = prev_closes.get(p['code'], buy_price)
                tc = today_closes.get(p['code'], base)
                carry_contrib += (tc - base) * shares
            holding_mv += tc * shares

        total_contrib = sell_contrib + carry_contrib + newbuy_contrib
        account = data.get('account', {})
        today_nav = account.get('cash', 0) + holding_mv
        # drawdown-boost状态机盘后滚动(Task#205): 盯市nav落
        # data/drawdown_state.json, 内部自兜底不影响日报主流程
        update_drawdown_boost_state(today, today_nav)
        prev_nav = today_nav - total_contrib  # 昨收净值=今净值倒推
        if prev_nav <= 0:
            prev_nav = account.get('initial_capital', 1000000)
        today_pnl_pct = total_contrib / prev_nav * 100
        breakdown = {
            'realized_pct': round(sell_contrib / prev_nav * 100, 2),
            'float_pct': round((carry_contrib + newbuy_contrib) /
                               prev_nav * 100, 2),
        }

        ok = notify_daily_summary(today, trades_log, round(today_pnl_pct, 2),
                                  breakdown=breakdown, note=note)
        print(f"[盘后日报] {today} 交易{len(trades_log)}笔 "
              f"今日收益(盯市){today_pnl_pct:+.2f}% "
              f"[卖出{breakdown['realized_pct']:+.2f}% "
              f"浮动{breakdown['float_pct']:+.2f}%] "
              f"昨净值¥{prev_nav:,.2f} 今净值¥{today_nav:,.2f} "
              f"发送{'成功' if ok else '失败'}")
        if ok:
            with open(_DAILY_REPORT_MARK, 'w') as f:
                f.write(today)
    except Exception as e:
        # 日报失败不能影响交易链路(auto-close主流程)
        print(f"[盘后日报] 发送异常(非致命): {e}")


# =============================================================================
# Main
# =============================================================================

def main():
    if len(sys.argv) < 2:
        cmd = 'check'
    else:
        cmd = sys.argv[1]

    if cmd in ('check', 'auto-close'):
        test_date = None
        hour = None
        auto_close = (cmd == 'auto-close')
        for i, arg in enumerate(sys.argv[2:], 2):
            if arg == '--test-date' and i < len(sys.argv) - 1:
                test_date = sys.argv[i + 1]
            elif arg.startswith('--test-date='):
                test_date = arg.split('=', 1)[1]
            elif arg == '--hour' and i < len(sys.argv) - 1:
                hour = int(sys.argv[i + 1])
            elif arg.startswith('--hour='):
                hour = int(arg.split('=', 1)[1])
            elif arg == '--auto-close':
                auto_close = True

        # daemon心跳协调(仅真实auto-close路径, 测试模式/手工check不受影响):
        # 守护进程存活→cron跳过防双写; 交易时段心跳超时→告警+cron接管兜底
        if auto_close and not test_date:
            # 盘后日报(Task#123): 必须置于daemon心跳跳过之前——15:01班次
            # daemon刚在15:00自然退出, 心跳可能仍新鲜(<60s)导致早退吞掉日报
            send_daily_report_if_due(datetime.now().strftime('%Y-%m-%d'))
            age = daemon_heartbeat_age()
            if age is not None and age < DAEMON_STALE_SEC:
                print(f"[{datetime.now().strftime('%F %T')}] [cron跳过] "
                      f"盘中守护进程存活(心跳{age:.0f}s前), "
                      f"卖出检查由intraday_monitor负责")
                return 0
            now = datetime.now()
            in_session = (now.weekday() < 5 and
                          '09:28' <= now.strftime('%H:%M') < '15:00')
            cand_file = os.path.join(
                OUTPUT_DIR, f"candidates_{now.strftime('%Y%m%d')}.json")
            # 交易日proxy: 当日candidates文件存在(与daemon自判交易日同口径),
            # 避免节假日误报daemon死亡
            if in_session and os.path.exists(cand_file):
                alert_daemon_down(age)
        check_positions(test_date, hour, auto_close)

    elif cmd == 'daily-report':
        # 手工触发盘后日报: --force跳过幂等重发, --note 标题后缀(如"修正版")
        force = '--force' in sys.argv
        note = ''
        for i, arg in enumerate(sys.argv[2:], 2):
            if arg == '--note' and i < len(sys.argv) - 1:
                note = sys.argv[i + 1]
            elif arg.startswith('--note='):
                note = arg.split('=', 1)[1]
        send_daily_report_if_due(datetime.now().strftime('%Y-%m-%d'),
                                 force=force, note=note)

    elif cmd == 'confirm-buy':
        confirm_buy()

    elif cmd == 'confirm-sell':
        if len(sys.argv) < 4:
            print("用法: python realtime/position_tracker.py confirm-sell CODE PRICE")
            return 1
        code = sys.argv[2]
        price = float(sys.argv[3])
        confirm_sell(code, price)

    elif cmd == 'add':
        if len(sys.argv) < 10:
            print("用法: python realtime/position_tracker.py add "
                  "CODE NAME STRATEGY SLOT_ID BUY_PRICE TP SL EXPIRE_DATE")
            return 1
        add_position(
            code=sys.argv[2],
            name=sys.argv[3],
            strategy=sys.argv[4],
            slot_id=sys.argv[5],
            buy_price=float(sys.argv[6]),
            tp_price=float(sys.argv[7]),
            sl_price=float(sys.argv[8]),
            expire_date=sys.argv[9],
        )

    elif cmd == 'list':
        list_positions()

    else:
        print(f"未知命令: {cmd}")
        print("可用命令: check, confirm-buy, confirm-sell, add, list")
        return 1

    return 0


if __name__ == '__main__':
    sys.exit(main())
