def _pid_runs_script(pid, script):
    """[Task#203] /proc/<pid>/cmdline精确核验: 某个argv token恰为脚本路径
    才算真在运行 — 排除shell -c包装串/日志查看等cmdline仅提及脚本名的
    误报(pgrep -f按全cmdline子串匹配, 实测会命中这类旁观者进程)。
    真实拉取进程形如 python3 -u /path/tools/fetch_daily_kline.py DATE,
    其shell包装层不需另计 — 子python进程本身必被直接命中。"""
    try:
        with open(f'/proc/{pid}/cmdline', 'rb') as f:
            argv = f.read().decode('utf-8', 'replace').split('\0')
    except OSError:
        return False   # 进程已退出(pgrep与核验间的竞态, 视为无占用)
    return any(a == script or a.endswith('/' + script) for a in argv)


def detect_concurrent_fetch(dry_run=False):
    """[Task#203] 并发互斥检测: pgrep -f 初筛 + /proc cmdline精确核验,
    返回占用描述列表(空=无互斥)。pgrep本身不匹配自身进程; 本脚本cmdline
    不含目标脚本名, 额外过滤自身pid双保险。dry-run可用环境变量
    T203_MOCK_MUTEX=busy|free mock检测结果(零真实pgrep依赖测试环境)。"""
    mock = os.environ.get('T203_MOCK_MUTEX', '')
    if dry_run and mock:
        return ([f'{s}(mock)' for s in MUTEX_FETCH_SCRIPTS]
                if mock == 'busy' else [])
    busy = []
    my_pid = str(os.getpid())
    for script in MUTEX_FETCH_SCRIPTS:
        try:
            r = subprocess.run(['pgrep', '-f', script.replace('.', r'\.')],
                               capture_output=True, text=True, timeout=10)
        except (subprocess.SubprocessError, OSError) as e:
            log(f"互斥检测pgrep异常(视为无占用, 不阻断): {script} {e}")
            continue
        pids = [p for p in r.stdout.split()
                if p and p != my_pid and _pid_runs_script(p, script)]
        if pids:
            busy.append(f"{script}(pid {','.join(pids)})")
    return busy


