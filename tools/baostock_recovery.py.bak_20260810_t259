def _mock_s1_cap_run(state, mock_n):
    """[Task#201] dry-run mock: 模拟mock_n只股的s1任务, 验证单日上限收工/
    事件写入/游标保存/次日续跑。零网络零DB写入, 游标存state文件
    mock_s1_done字段(对应真实路径的fetch_progress+DB断点续传)。"""
    done_before = int(state.data.get('mock_s1_done', 0))
    remaining = mock_n - done_before
    if remaining <= 0:
        return 'done', f'[dry-run][mock] {mock_n}只已全部完成'
    cap_remaining = state.cap_left()
    if cap_remaining <= 0:
        return ('paused_cap',
                f'[dry-run][mock] 今日上限已用尽, done={done_before} '
                f'remain={remaining}, 次日续跑')
    n_process = min(cap_remaining, remaining)
    log(f"[dry-run][mock] s1模拟任务{mock_n}只, 已完成游标{done_before}, "
        f"本次从第{done_before + 1}只开始处理{n_process}只 "
        f"(今日剩余上限{cap_remaining}/{DAILY_BACKFILL_CAP})")
    state.data['mock_s1_done'] = done_before + n_process
    state.cap_spend(n_process)
    done_now = done_before + n_process
    if done_now < mock_n:
        record_daily_cap_reached(done_now, mock_n - done_now, dry_run=True)
        return ('paused_cap',
                f'[dry-run][mock] 单日处理量达上限{DAILY_BACKFILL_CAP}, '
                f'done={done_now} remain={mock_n - done_now}, 游标已保存')
    return 'done', f'[dry-run][mock] 全部{mock_n}只完成(本次{n_process}只)'


def run_s1_stock_hour(state, dry_run):
    # [Task#201] mock验证路径: T201_MOCK_S1_TODO=N 模拟N只股任务(仅dry-run)
    mock_n = int(os.environ.get('T201_MOCK_S1_TODO', '0'))
    if dry_run and mock_n:
        return _mock_s1_cap_run(state, mock_n)
    conn = db_connect(DB)
    degraded = scan_degraded_dates(conn)
    if not degraded:
        conn.close()
        return 'done', '无降级日(hour列已齐)'
    done_dates, todo = [], []
    for d, total, _ in degraded:
        (done_dates if date_done_s1(conn, d) else todo).append((d, total))
    for idx, (d, total) in enumerate(todo):
        est = 2 * total   # 每股2请求(日K+60minK)
        if in_quiet_window():
            conn.close()
            return 'paused_market', f'静默窗口, 待续日期: {[x[0] for x in todo]}'
        # [Task#222] 批间检查点: 长跑中途进入18:25日更窗口 → 让路收工保存进度
        # (已完成日期的进度在DB+fetch_progress中, 断点续传下轮自动跳过)
        if daily_update_window_pending(dry_run=dry_run):
            conn.close()
            record_deferred_daily_window(dry_run=dry_run)
            return ('paused_daily_window',
                    f'18:25起日更窗口让路收工, 待续日期: '
                    f'{[x[0] for x in todo[idx:]]}')
        if state.budget_left() < est:
            conn.close()
            return ('paused_budget',
                    f'{d}需~{est}请求 > 今日剩余预算{state.budget_left()}, 次日续')
        # [Task#201] 单日处理股票数上限: 用尽则优雅收工次日续
        cap_remaining = state.cap_left()
        if cap_remaining <= 0:
            conn.close()
            remain = sum(t for _, t in todo[idx:])
            return ('paused_cap',
                    f'今日处理量上限{DAILY_BACKFILL_CAP}已用尽, '
                    f'待续日期{[x[0] for x in todo[idx:]]}(~{remain}只), 次日续')
        if dry_run:
            log(f"[dry-run] 计划执行: fetch_daily_kline.py {d} (~{est}请求)")
            continue
        log(f"s1: 回补 {d} hour列 (~{est}请求, 复用fetch_daily_kline限速铁律; "
            f"今日剩余处理量{cap_remaining}/{DAILY_BACKFILL_CAP})")
        state.budget_spend(est)
        # [Task#201] 剩余上限不够覆盖本日全部股票 → 传入子进程处理量上限
        # (子进程达上限后commit+保存progress游标, 退出码4优雅收工)
        env = os.environ.copy()
        if cap_remaining < total:
            env['T201_MAX_STOCKS'] = str(cap_remaining)
        r = subprocess.run(
            [sys.executable, os.path.join(TOOLS, 'fetch_daily_kline.py'), d],
            cwd=PROJECT_ROOT, timeout=4 * 3600, env=env)
        if r.returncode == 4:
            # [Task#201] 子进程达处理量上限优雅收工(非失败)
            state.cap_spend(cap_remaining)
            conn.close()
            done_today = DAILY_BACKFILL_CAP - state.cap_left()
            remain = (total - cap_remaining
                      + sum(t for _, t in todo[idx + 1:]))
            record_daily_cap_reached(done_today, remain)
            return ('paused_cap',
                    f'{d}处理{cap_remaining}只后达单日上限'
                    f'{DAILY_BACKFILL_CAP}, done={done_today} '
                    f'remain={remain}, 次日续跑(断点续传自动跳已完成)')
        if r.returncode != 0:
            conn.close()
            return 'failed', f'{d} fetch_daily_kline退出码{r.returncode}'
        state.cap_spend(total)   # [Task#201] 整日完成, 记账(上界口径)
        if not date_done_s1(conn, d):
            conn.close()
            return 'failed', f'{d} 回补后hour1 NULL占比仍>={NULL_DONE_RATIO:.0%}'
        log(f"s1: {d} 完成(NULL占比达标)")
    conn.close()
    if dry_run and todo:
        return 'done', f'[dry-run] 计划{len(todo)}日: {[x[0] for x in todo]}'
    return 'done', f'回补{len(todo)}日, 已达标{len(done_dates) + len(todo)}日'


def run_s2_index(state, dry_run):
    conn = db_connect(DB)
    # 降级判据: amount NULL(腾讯源不含amount字段)
    dates = [r[0] for r in conn.execute(
        "SELECT date FROM index_kline WHERE code='sh.000001' "
        "AND date >= ? AND amount IS NULL ORDER BY date",
        (DEGRADE_SINCE,))]
    if not dates:
        conn.close()
        return 'done', '无amount缺失行'
    if in_quiet_window():
        conn.close()
        return 'paused_market', f'静默窗口, 待续: {dates}'
    # [Task#222] 日更窗口检查点: s2也写stocks.db, 同样让路
    if daily_update_window_pending(dry_run=dry_run):
        conn.close()
        record_deferred_daily_window(dry_run=dry_run)
        return 'paused_daily_window', f'日更窗口让路, 待续: {dates}'
    est = len(dates) + 2
    if state.budget_left() < est:
        conn.close()
        return 'paused_budget', f'需~{est}请求超预算, 次日续'
    if dry_run:
        conn.close()
        return 'done', f'[dry-run] 计划BaoStock权威刷新{len(dates)}行: {dates}'
    import math
    import baostock as bs

    def sf(v):
        if v is None or v == '':
            return None
        try:
            x = float(v)
            return None if math.isnan(x) or math.isinf(x) else x
        except (ValueError, TypeError):
            return None

    def rate(p, pre):
        return (round((p / pre - 1) * 100, 4)
                if p is not None and pre else None)

    lg = bs.login()
    if lg.error_code != '0':
        conn.close()
        # [Task#194] 熔断: 再遇黑名单立即写re_banned事件并停止
        if '10001011' in str(lg.error_code) + str(lg.error_msg) \
                or '黑名单' in str(lg.error_msg):
            record_re_banned(f's2_index login再遇10001011: {lg.error_msg}')
        return 'failed', f'BaoStock login失败({lg.error_code}), 疑似再度封禁'
    state.budget_spend(1)
    filled = 0
    for d in dates:
        time.sleep(BAOSTOCK_MIN_INTERVAL)
        state.budget_spend(1)
        rs = bs.query_history_k_data_plus(
            'sh.000001', 'date,code,open,high,low,close,preclose,volume,amount',
            start_date=d, end_date=d, frequency='d')
        # [Task#194] 熔断: 回补中途任何请求再遇10001011 → 立即停止
        if '10001011' in str(rs.error_code) + str(rs.error_msg) \
                or '黑名单' in str(rs.error_msg):
            bs.logout()
            conn.close()
            record_re_banned(f's2_index查询{d}再遇10001011: {rs.error_msg}')
            return 'failed', f's2查询{d}再遇黑名单, 已熔断写re_banned事件'
        rows = []
        while rs.error_code == '0' and rs.next():
            rows.append(rs.get_row_data())
        if not rows:
            log(f"s2: {d} BaoStock返回空, 保留腾讯行不动")
            continue
        row = rows[0]
        o, h, l, c, pre = [sf(x) for x in row[2:7]]
        vol, amt = sf(row[7]), sf(row[8])
        # REPLACE会清红盘占比等既有列 → 先读出写回
        old = conn.execute(
            "SELECT red_ratio FROM index_kline WHERE code='sh.000001' "
            "AND date=?", (d,)).fetchone()
        red = old[0] if old else None
        vals = [d, 'sh.000001', '上证综指', o, h, l, c, pre, vol, amt,
                rate(o, pre), rate(h, pre), rate(l, pre), rate(c, pre)]
        vals.extend([None] * 40)
        vals.append(red)
        conn.execute('INSERT OR REPLACE INTO index_kline VALUES ('
                     + ','.join(['?'] * 55) + ')', vals)
        conn.commit()
        filled += 1
        log(f"s2: {d} 权威刷新 close={c} amount={amt}")
    bs.logout()
    conn.close()
    return 'done', f'权威刷新{filled}/{len(dates)}行(red_ratio保留)'


