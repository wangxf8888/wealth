def run_pipeline(state, dry_run=False):
    state.data['state'] = 'running'
    if not state.data.get('triggered_at'):
        state.data['triggered_at'] = datetime.now().strftime(
            '%Y-%m-%d %H:%M:%S')
    state.save()
    for name in STEPS:
        st = state.step(name)
        if st['status'] == 'done':
            continue
        log(f"=== 步骤 {name} 开始 (断点续跑: 之前状态={st['status']}) ===")
        state.set_step(name, 'running')
        try:
            result, detail = STEP_FUNCS[name](state, dry_run)
        except Exception as e:
            result, detail = 'failed', f'{type(e).__name__}: {e}'
        if result == 'done':
            state.set_step(name, 'done', detail)
            log(f"=== 步骤 {name} 完成: {detail} ===")
        elif result in ('paused_market', 'paused_budget', 'paused_cap',
                        'paused_daily_window'):
            state.set_step(name, 'pending', detail)
            state.data['state'] = result
            state.save()
            log(f"流水线暂停({result}): {detail} — resume cron自动续跑")
            # [Task#201] 单日处理量达上限属优雅收工(游标已存+事件已写),
            # 退出码0区别于其他暂停; 次日resume cron自然续跑
            # [Task#222] 日更窗口让路同属优雅收工(退出码0, 下轮resume再试)
            return (0 if result in ('paused_cap', 'paused_daily_window')
                    else 1)
        else:
            state.set_step(name, 'failed', detail)
            state.data['state'] = 'failed'
            state.save()
            alert(f"恢复流水线步骤{name}失败: {detail} — 人工介入后 --resume 续跑")
            log(f"步骤 {name} 失败: {detail}")
            return 2
    state.data['state'] = 'done'
    state.save()
    return 0


