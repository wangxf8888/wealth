def run_s5_f2_verify(state, dry_run):
    """F2约束力恢复验证: 严格(max_seal_hour_b2=1) vs 宽松(None)重跑S5候选。"""
    if dry_run:
        return 'done', ('[dry-run] 计划: 最近3信号日S5候选 严格vs宽松 diff '
                        '+对照当晚candidates json')
    from realtime.data_feed import RealtimeDataFeed
    from strategies.two_board_pullback_dip_h1c import (
        TwoBoardPullbackDipH1cStrategy)
    conn = db_connect(DB)
    sig_dates = [r[0] for r in conn.execute(
        "SELECT DISTINCT date FROM stock_kline ORDER BY date DESC LIMIT 3")]
    conn.close()
    sig_dates.reverse()
    report, contaminated = [], []
    for sd in sig_dates:
        feed = RealtimeDataFeed(DB)
        # signal模式重放当晚22:00候选生成(trade_date用合成次日占位)
        trade_date = sd + '_next'
        feed.set_signal_mode(sd, trade_date)
        strict = TwoBoardPullbackDipH1cStrategy()
        assert strict.max_seal_hour_b2 == 1, 'S5生产参数漂移, 验证前提失效'
        strict_set = set(strict.get_candidates(trade_date, feed))
        lenient = TwoBoardPullbackDipH1cStrategy()
        lenient.max_seal_hour_b2 = None   # 封禁期NULL hour的等效行为
        lenient_set = set(lenient.get_candidates(trade_date, feed))
        feed.close()
        removed = sorted(lenient_set - strict_set)
        report.append(f"{sd}: 宽松{len(lenient_set)}只 → 严格{len(strict_set)}只"
                      f", F2剔除{len(removed)}只 {removed if removed else ''}")
        # 对照当晚真实candidates json里的S5(封禁期生成=宽松口径)
        for f in sorted(os.listdir(RT_DIR)):
            if not (f.startswith('candidates_') and f.endswith('.json')):
                continue
            try:
                cj = json.load(open(os.path.join(RT_DIR, f), encoding='utf-8'))
            except (json.JSONDecodeError, OSError):
                continue
            if cj.get('signal_date') != sd:
                continue
            s5 = cj.get('strategies', {}).get('S5', {})
            stored = {c['code'] for c in s5.get('candidates', [])}
            polluted = sorted(stored & set(removed))
            if polluted:
                contaminated.append(f"{f} S5含F2应剔除候选: {polluted}")
    detail = ' | '.join(report)
    if contaminated:
        alert("F2验证发现封禁期候选污染: " + '; '.join(contaminated))
        detail += ' ⚠️污染: ' + '; '.join(contaminated)
    alert(f"F2约束力恢复验证完成: {detail}")
    return 'done', detail


