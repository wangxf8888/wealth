def db_connect(path):
    """[Task#222] 统一SQLite连接入口: timeout=60+busy_timeout=60000 —
    撞锁时排队等待而非默认5s即抛database is locked(8/7事故263只日K
    缺口的兜底保险, 与fetch_daily_kline.py同配置)。"""
    conn = sqlite3.connect(path, timeout=SQLITE_TIMEOUT)
    conn.execute(f"PRAGMA busy_timeout={SQLITE_BUSY_TIMEOUT_MS}")
    return conn


