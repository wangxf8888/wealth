def scan_degraded_dates(conn):
    """stock_kline中hour1_close NULL占比>50%的日期(DEGRADE_SINCE起)。"""
    rows = conn.execute(
        "SELECT date, COUNT(*), SUM(hour1_close IS NULL) FROM stock_kline "
        "WHERE date >= ? GROUP BY date ORDER BY date",
        (DEGRADE_SINCE,)).fetchall()
    return [(d, total, nnull) for d, total, nnull in rows
            if total > 0 and nnull / total > 0.5]


def date_done_s1(conn, d):
    total, nnull = conn.execute(
        "SELECT COUNT(*), SUM(hour1_close IS NULL) FROM stock_kline "
        "WHERE date = ?", (d,)).fetchone()
    return total > 0 and (nnull or 0) / total < NULL_DONE_RATIO


