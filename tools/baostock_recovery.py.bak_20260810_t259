    if args.status:
        print(json.dumps(state.data, ensure_ascii=False, indent=2))
        return 0

    # 前置守卫: 只信探测结果, 本脚本绝不自己撞BaoStock login
    try:
        with open(ban_path, encoding='utf-8') as f:
            ban = json.load(f)
    except (json.JSONDecodeError, OSError):
        ban = {}
    if not ban.get('recovered'):
        if args.resume:
            return 0        # 待命: 未解禁, cron秒退
        log("ban_status.recovered != true, 流水线待命不启动")
        return 0

    if state.data['state'] == 'done':
        if not args.resume:
            log("流水线已完成(state=done), 幂等退出")
        return 0
    if args.resume and state.data['state'] == 'idle':
        # 解禁但从未触发(钩子失效场景的兜底): resume cron代为触发
        log("resume兜底: 检测到已解禁但流水线未触发, 代为启动")
    if args.resume and state.data['state'] == 'failed':
        return 0            # 失败态不自动重试, 等人工介入后手动--resume? 手动跑无--resume即可

    # flock防重入(同一状态文件维度)
    lock_path = state_path + '.lock'
    lock_f = open(lock_path, 'w')
    try:
        fcntl.flock(lock_f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("另一实例正在运行(flock占用), 退出")
        return 0

    try:
        if state.data['state'] == 'failed':
            log("失败态手动续跑: 重置failed步骤为pending")
            for s in STEPS:
                if state.step(s)['status'] == 'failed':
                    state.set_step(s, 'pending', '手动续跑重置')
        # [Task#203] 并发互斥门: 位于冷静期二次确认之后(probe端pending_confirm
        # →recovered状态推进在probe脚本内完成, 不经过此处不受影响)、实际回补
        # 启动之前 — 网络步骤(s1-s3)尚未全部完成且数据拉取脚本在跑时, 本轮
        # 优雅顺延退出码0, 下轮resume cron(每小时:25)自然再试; 无网络尾步
        # (s4-s6)不受互斥门约束可继续收尾。
        if any(state.step(s)['status'] != 'done' for s in NET_STEPS):
            # [Task#222] 日更窗口让路门(反向互斥): 交易日18:25~23:59内当日
            # daily_update链未完成 → 回补不启动, 让18:30日K更新独占stocks.db
            # 写锁(8/7事故: recovery长跑持锁至19:06致日K前263只撞锁;
            # Hal#203只防了recovery启动时fetch已在跑的单向)。
            if daily_update_window_pending(dry_run=args.dry_run):
                record_deferred_daily_window(dry_run=args.dry_run)
                # 顺延态落盘(同Hal#203 deferred_mutex时序修复): 若保持failed/
                # idle, 下轮--resume会被前置守卫秒退永不再试
                state.data['state'] = 'deferred_daily_window'
                state.save()
                log("日更窗口让路门: 18:25~23:59且当日daily_update未完成, "
                    "本轮回补顺延(退出码0, 下轮resume cron再试)")
                return 0
            busy = detect_concurrent_fetch(dry_run=args.dry_run)
            if busy:
                record_deferred_concurrent_fetch(busy, dry_run=args.dry_run)
                # 顺延态落盘: 若保持failed/idle, 下轮--resume会被前置守卫
                # 秒退永不再试 — 置deferred_mutex让resume cron正常接住
                state.data['state'] = 'deferred_mutex'
                state.save()
                log(f"并发互斥门: {'/'.join(busy)} 在跑, 本轮回补顺延"
                    f"(退出码0, 下轮resume cron再试)")
                return 0
        return run_pipeline(state, dry_run=args.dry_run)
    finally:
        fcntl.flock(lock_f, fcntl.LOCK_UN)
        lock_f.close()


if __name__ == '__main__':
    sys.exit(main())
