class State:
    def __init__(self, path):
        self.path = path
        self.data = self._load()

    def _load(self):
        if os.path.exists(self.path):
            try:
                with open(self.path, encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, OSError):
                pass
        return {'version': 1, 'state': 'idle', 'triggered_at': None,
                'steps': {s: {'status': 'pending', 'detail': ''}
                          for s in STEPS},
                'budget': {'date': '', 'used': 0}}

    def save(self):
        self.data['updated_at'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        d = os.path.dirname(self.path)
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=d, prefix='.recovery_state_')
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(self.data, f, ensure_ascii=False, indent=2)
        os.chmod(tmp, 0o644)
        os.replace(tmp, self.path)

    def step(self, name):
        return self.data['steps'].setdefault(
            name, {'status': 'pending', 'detail': ''})

    def set_step(self, name, status, detail=''):
        st = self.step(name)
        st['status'] = status
        st['detail'] = detail
        st['updated_at'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        self.save()

    # --- 预算(跨日自动重置) ---
    def budget_left(self):
        today = _date.today().isoformat()
        b = self.data['budget']
        if b.get('date') != today:
            b['date'] = today
            b['used'] = 0
            self.save()
        return DAILY_BUDGET - b['used']

    def budget_spend(self, n):
        self.budget_left()   # 确保date对齐
        self.data['budget']['used'] += int(n)
        self.save()

    # --- [Task#201] 单日处理股票数上限(跨日自动重置, 与预算同构) ---
    def cap_left(self):
        today = _date.today().isoformat()
        c = self.data.setdefault('daily_cap',
                                 {'date': '', 'processed': 0})
        if c.get('date') != today:
            c['date'] = today
            c['processed'] = 0
            self.save()
        return DAILY_BACKFILL_CAP - c['processed']

    def cap_spend(self, n):
        self.cap_left()   # 确保date对齐
        self.data['daily_cap']['processed'] += int(n)
        self.save()


def in_quiet_window(now=None):
    """交易日08:30-16:00网络静默(盘中行情优先+晨间决策静默的并集)。
    [Task#194] 上界15:00→16:00: 解禁确认发生在交易时段时, 回补推迟到
