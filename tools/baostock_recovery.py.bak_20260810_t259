def daily_update_window_pending(now=None, dry_run=False):
    """[Task#222] 日更窗口让路判定: 交易日(周一至五)18:25~23:59且当日
    daily_update链未完成(logs/daily_update_YYYYMMDD.log无"每日数据更新结束"
    行) → True(recovery应让路)。8/7事故: recovery长跑实例持stocks.db写锁至
    19:06, 18:30日K更新前263只全部撞锁; Hal#203互斥门只防了recovery启动时
    fetch已在跑的单向, 本函数补反向。周末daily_update cron(1-5)不跑, 不受
    此约束(周末回补窗口不浪费)。日更完成后(日志出现结束行)窗口内即放行。
    窗口上界自然为当日23:59, 跨天后hm归零自动出窗。
    dry-run可用环境变量T222_MOCK_DAILY_WINDOW=busy|free mock判定结果。"""
    mock = os.environ.get('T222_MOCK_DAILY_WINDOW', '')
    if dry_run and mock:
        return mock == 'busy'
    now = now or datetime.now()
    if now.weekday() >= 5:
        return False
    hm = now.hour * 60 + now.minute
    if hm < DAILY_WINDOW_START_HM:
        return False
    log_path = os.path.join(DAILY_LOG_DIR,
                            f"daily_update_{now.strftime('%Y%m%d')}.log")
    try:
        with open(log_path, encoding='utf-8', errors='replace') as f:
            return DAILY_DONE_MARK not in f.read()
    except OSError:
        return True   # 窗口内日志尚未生成 = 日更还没跑完, 保守让路


