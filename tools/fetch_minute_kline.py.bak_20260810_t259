SCHEMA = """
CREATE TABLE IF NOT EXISTS minute_kline (
    code    TEXT NOT NULL,
    date    TEXT NOT NULL,          -- 'YYYY-MM-DD'
    time    TEXT NOT NULL,          -- 'HHMM' bar结束时刻(0935..1500)
